<Application x:Class="MediaManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaManager.App"
             xmlns:vm="clr-namespace:MediaManager.App.ViewModels"
             xmlns:conv="clr-namespace:MediaManager.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 索引 0 必须是主题字典：App.SetThemeAsync 靠替换 [0] 切主题 -->
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Languages/zh-CN.xaml" />
                <!-- 系统控件重绘（DatePicker / Calendar），只写模板、颜色走 DynamicResource，
                     所以深浅两套主题共用这一份，放最后不影响主题替换 -->
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:BoolToArrowConverter x:Key="BoolToArrow" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:DiscoveryPoolVisConverter x:Key="DiscoveryPoolVis" />
            <conv:MultiplyConverter x:Key="Multiply" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
