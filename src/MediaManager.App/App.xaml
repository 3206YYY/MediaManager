<Application x:Class="MediaManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediaManager.App"
             xmlns:vm="clr-namespace:MediaManager.App.ViewModels"
             xmlns:conv="clr-namespace:MediaManager.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Languages/zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:BoolToArrowConverter x:Key="BoolToArrow" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:DiscoveryPoolVisConverter x:Key="DiscoveryPoolVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
