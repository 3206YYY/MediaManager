<Window x:Class="MediaManager.App.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="视频播放器" Width="1080" Height="650"
        MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#08090A"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonUp="OnWindowPreviewMouseUp"
        LostMouseCapture="OnWindowLostMouseCapture">

    <Window.Resources>
        <!-- 控制栏按钮：透明底 + 悬停高亮（深色叠加层专用，不跟随主题） -->
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 中央提示面板的操作按钮：hover / pressed 只改透明度。
             继承 OverlayButton 的话，模板触发器会把背景换成半透明白，
             实心蓝按钮一悬停反而变淡，看起来像被禁用。 -->
        <Style x:Key="CenterActionButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放/暂停主按钮：圆形亮底 -->
        <Style x:Key="PrimaryRoundButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#121316" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D9FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条：细轨道 + 白色圆点 -->
        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="0.1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="root" Height="18" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="bg" Height="4" CornerRadius="2" Background="#3DFFFFFF"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="fill" Height="4" CornerRadius="2"
                                                        Background="#FF4EA1FF" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="thumb" Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 悬停时轨道变粗：现代播放器的手感 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 音量条：更细更短 -->
        <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource SeekSlider}">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!-- 弹出菜单里的选项 -->
        <Style x:Key="PopupItem" TargetType="Button">
            <Setter Property="Foreground" Value="#E8FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#08090A">
        <!-- 视频宿主：单独一层 Grid 包住 VideoView，SizeChanged 时强刷 vout -->
        <Grid x:Name="VideoHost" Background="Black" SizeChanged="OnVideoHostSizeChanged">

            <!-- VideoView.Content 会被 LibVLCSharp 放进一个独立的透明前景窗口，
                 这是唯一能「真正叠在视频画面上」的 WPF 图层（HwndHost 的 airspace 限制）。 -->
            <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid x:Name="OverlayRoot" Background="#01000000">
                    <Grid x:Name="ChromeRoot" Opacity="1">

                        <!-- 顶部：文件名 + 第几个 -->
                        <Border x:Name="TopBar" VerticalAlignment="Top" Padding="20,14,20,30">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B3000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="#F2FFFFFF"
                                               TextTrimming="CharacterEllipsis" MaxWidth="640" />
                                    <TextBlock x:Name="PlaylistIndexText" Text="" FontSize="11.5"
                                               Foreground="#8FFFFFFF" Margin="10,1,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 底部悬浮控制栏 -->
                        <Border x:Name="ControlBar" VerticalAlignment="Bottom" Margin="16,0,16,16"
                                CornerRadius="12" Background="#E6121316"
                                BorderBrush="#1FFFFFFF" BorderThickness="1"
                                Padding="14,9,14,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Slider x:Name="ProgressSlider" Style="{StaticResource SeekSlider}"
                                            Minimum="0" Maximum="1" Value="0"
                                            ValueChanged="OnProgressValueChanged"
                                            Thumb.DragStarted="OnSeekDragStarted"
                                            Thumb.DragCompleted="OnSeekDragCompleted" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PlayPauseButton" Grid.Column="0"
                                            Style="{StaticResource PrimaryRoundButton}"
                                            Click="OnPlayPauseClick" ToolTip="播放 / 暂停（空格）">
                                        <TextBlock x:Name="PlayPauseGlyph" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#121316"
                                                   Text="&#xE768;" FontSize="13" />
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock x:Name="TimeText" Text="00:00" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="#F2FFFFFF"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" / " FontSize="12.5" Foreground="#70FFFFFF"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="TotalText" Text="00:00" FontSize="12.5"
                                                   Foreground="#A8FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 播放模式（左下角）：连播 / 播完暂停 / 随机 -->
                                    <Button x:Name="ModeButton" Grid.Column="2" Style="{StaticResource OverlayButton}"
                                            Click="OnModeButtonClick" ToolTip="播放结束后的行为">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EE;"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="ModeText" Text="播完暂停" FontSize="12" Foreground="#F2FFFFFF"
                                                       VerticalAlignment="Center" />
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;"
                                                       FontSize="8" VerticalAlignment="Center"
                                                       Margin="6,0,0,0" Foreground="#80FFFFFF" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 音量 -->
                                    <Button x:Name="VolumeButton" Grid.Column="4" Style="{StaticResource OverlayButton}"
                                            Click="OnMuteClick" ToolTip="静音（M）">
                                        <TextBlock x:Name="VolumeGlyph" FontFamily="Segoe MDL2 Assets" Foreground="#F2FFFFFF"
                                                   Text="&#xE767;" FontSize="14" />
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Grid.Column="5" Style="{StaticResource VolumeSlider}"
                                            Minimum="0" Maximum="100" Value="80"
                                            VerticalAlignment="Center" Margin="2,0,8,0"
                                            ValueChanged="OnVolumeSliderChanged" />

                                    <!-- 倍速 -->
                                    <Button x:Name="SpeedButton" Grid.Column="6" Style="{StaticResource OverlayButton}"
                                            Click="OnSpeedButtonClick" ToolTip="播放速度"
                                            Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SpeedText" Text="1.0x" FontSize="12" Foreground="#F2FFFFFF"
                                                       VerticalAlignment="Center" />
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;"
                                                       FontSize="8" VerticalAlignment="Center"
                                                       Margin="5,0,0,0" Foreground="#80FFFFFF" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="FullScreenButton" Grid.Column="7" Style="{StaticResource OverlayButton}"
                                            Click="OnFullScreenClick" ToolTip="全屏 / 退出全屏（F）"
                                            Margin="2,0,0,0">
                                        <TextBlock x:Name="FullScreenGlyph" FontFamily="Segoe MDL2 Assets" Foreground="#F2FFFFFF"
                                                   Text="&#xE740;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 操作提示（音量 / 倍速 / 快进快退） -->
                        <Border x:Name="ActionToast" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,96" Background="#CC000000" CornerRadius="16"
                                Padding="16,7" Opacity="0" IsHitTestVisible="False">
                            <TextBlock x:Name="ActionToastText" Text="" FontSize="12.5"
                                       Foreground="#F2FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- 中央提示：播放失败 / 播放结束（不跟随控制栏淡出）
                         面板必须足够不透明：视频画面经常是高对比度彩条/白底，
                         半透明面板会让标题和按钮「糊」在画面里看不清。 -->
                    <Border x:Name="CenterPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#F5161719" CornerRadius="14"
                            BorderBrush="#3DFFFFFF" BorderThickness="1"
                            Padding="30,24" MaxWidth="560">
                        <StackPanel>
                            <TextBlock x:Name="CenterTitle" Text="无法播放此视频"
                                       FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="CenterDetail" Text=""
                                       FontSize="12.5" Foreground="#D6FFFFFF"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,9,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,18,0,0">
                                <Button x:Name="CenterPrimaryButton" Content="重试"
                                        Style="{StaticResource CenterActionButton}"
                                        Background="#FF2F7CF6"
                                        Click="OnCenterPrimaryClick" />
                                <Button x:Name="CenterSecondaryButton" Content="播放下一个"
                                        Style="{StaticResource CenterActionButton}"
                                        Background="#33FFFFFF"
                                        Margin="10,0,0,0" Click="OnCenterSecondaryClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 倍速菜单 -->
                    <Popup x:Name="SpeedPopup" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           PlacementTarget="{Binding ElementName=SpeedButton}"
                           HorizontalOffset="-24" VerticalOffset="-8">
                        <Border Background="#F2161719" CornerRadius="10"
                                BorderBrush="#26FFFFFF" BorderThickness="1" Padding="5">
                            <StackPanel x:Name="SpeedList" />
                        </Border>
                    </Popup>

                    <!-- 播放模式菜单 -->
                    <Popup x:Name="ModePopup" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           PlacementTarget="{Binding ElementName=ModeButton}"
                           HorizontalOffset="0" VerticalOffset="-8">
                        <Border Background="#F2161719" CornerRadius="10"
                                BorderBrush="#26FFFFFF" BorderThickness="1" Padding="5">
                            <StackPanel x:Name="ModeList" />
                        </Border>
                    </Popup>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Grid>
</Window>
