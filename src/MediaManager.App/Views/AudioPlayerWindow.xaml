<Window x:Class="MediaManager.App.Views.AudioPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频播放器" Width="560" Height="210"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        KeyDown="OnKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button Content="▶" Width="40" Click="OnPlayPause" ToolTip="播放 / 暂停（空格）" />
            <TextBlock x:Name="TimeText" Text="00:00 / 00:00" VerticalAlignment="Center"
                       Margin="10,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="0.5x" Width="42" Click="OnSpeedHalf" ToolTip="0.5 倍速" />
            <Button Content="1x" Width="42" Margin="4,0" Click="OnSpeedNormal" ToolTip="正常速度" />
            <Button Content="1.5x" Width="42" Click="OnSpeedOneHalf" ToolTip="1.5 倍速" />
            <Button Content="2x" Width="42" Margin="4,0,0,0" Click="OnSpeedDouble" ToolTip="2 倍速" />
        </StackPanel>

        <Slider x:Name="ProgressSlider" Grid.Row="2" Minimum="0" Maximum="100" Value="0"
                FocusVisualStyle="{x:Null}" VerticalAlignment="Center"
                Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd"
                PreviewMouseLeftButtonDown="OnSeekMouseDown"
                PreviewMouseLeftButtonUp="OnSeekMouseUp" />

        <TextBlock Grid.Row="3" Text="音频只读播放，不进入编辑流程。← → 快退/快进 5 秒。"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" />
    </Grid>
</Window>
