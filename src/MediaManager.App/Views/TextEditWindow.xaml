<Window x:Class="MediaManager.App.Views.TextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加文字" Width="420" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="输入文字" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBox x:Name="TextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

        <TextBlock Text="位置" FontWeight="Bold" Margin="0,0,0,6" />
        <ComboBox x:Name="PositionBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
            <ComboBoxItem Content="左上" Tag="topleft" />
            <ComboBoxItem Content="上中" Tag="topcenter" />
            <ComboBoxItem Content="右上" Tag="topright" />
            <ComboBoxItem Content="左中" Tag="centerleft" />
            <ComboBoxItem Content="中间" Tag="center" />
            <ComboBoxItem Content="右中" Tag="centerright" />
            <ComboBoxItem Content="左下" Tag="bottomleft" />
            <ComboBoxItem Content="下中" Tag="bottomcenter" IsSelected="True" />
            <ComboBoxItem Content="右下" Tag="bottomright" />
        </ComboBox>

        <TextBlock Text="颜色" FontWeight="Bold" Margin="0,0,0,6" />
        <ComboBox x:Name="ColorBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16">
            <ComboBoxItem Content="白色" Tag="#FFFFFF" IsSelected="True" />
            <ComboBoxItem Content="黑色" Tag="#000000" />
            <ComboBoxItem Content="红色" Tag="#FF3B3B" />
            <ComboBoxItem Content="黄色" Tag="#FFD43B" />
            <ComboBoxItem Content="蓝色" Tag="#3B82F6" />
            <ComboBoxItem Content="绿色" Tag="#2E9E5B" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="90" Click="OnOk"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" />
            <Button Content="取消" Width="90" Margin="8,0,0,0" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
