<Window x:Class="MediaManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="640" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- 数据目录（只读，由便携模式决定） -->
            <TextBlock Text="数据目录" FontWeight="Bold" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0" Click="OnOpenDataDir" />
                <TextBox x:Name="DataDirBox" IsReadOnly="True" Background="{DynamicResource PanelBrush}" />
            </DockPanel>
            <TextBlock Text="（数据目录由便携模式决定，无法直接修改。如需迁移数据，请使用下方「导出/导入」。）"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- 缩略图缓存：路径 + 占用 + 清理 -->
            <TextBlock Text="缩略图缓存" FontWeight="Bold" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0" Click="OnOpenCacheDir" />
                <TextBox x:Name="CacheDirBox" IsReadOnly="True" Background="{DynamicResource PanelBrush}" />
            </DockPanel>

            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="🧹 清理缓存" VerticalAlignment="Center"
                            Margin="12,0,0,0" Click="OnCleanCache" />
                    <StackPanel>
                        <TextBlock x:Name="CacheSizeText" Text="正在统计…" FontWeight="SemiBold" />
                        <TextBlock Text="清理后，缩略图会在您浏览时自动重新生成；原始图片/视频不会受任何影响。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- FFmpeg 路径 -->
            <TextBlock Text="FFmpeg 路径" FontWeight="Bold" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseFfmpeg" />
                <TextBox x:Name="FfmpegBox" />
            </DockPanel>

            <!-- 并发数 -->
            <TextBlock Text="缩略图并发数" FontWeight="Bold" Margin="0,0,0,6" />
            <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="8" IsSnapToTickEnabled="True"
                    TickFrequency="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <!-- 主题 -->
            <TextBlock Text="主题" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="浅色" Tag="Light" />
                <ComboBoxItem Content="深色" Tag="Dark" />
            </ComboBox>

            <!--
            语言切换（English）尚未完成，入口暂时隐藏，仅保留中文。
            恢复时机：完整的多语言资源与 RTL/字体适配做完后，把下面这段注释去掉即可。
            -->
            <!-- 语言 -->
            <!--
            <TextBlock Text="语言" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="中文" Tag="Chinese" />
                <ComboBoxItem Content="English" Tag="English" />
            </ComboBox>
            -->

            <!-- 系统集成 -->
            <TextBlock Text="系统集成" FontWeight="Bold" Margin="0,0,0,6" />
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="ShellIntegrationBox" Content="在资源管理器右键菜单里添加「用媒体管理器打开」"
                              FontWeight="SemiBold" Click="OnShellIntegrationClick" />
                    <TextBlock Text="勾选后，在 Windows 里右键点任意图片即可直接用本程序打开（只写入当前用户，不需要管理员权限）。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="24,4,0,0" />
                    <TextBlock x:Name="ShellIntegrationStateText" FontSize="11" Margin="24,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 删除行为 -->
            <TextBlock Text="删除行为" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="DeleteBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="回收站（默认）" Tag="RecycleBin" />
                <ComboBoxItem Content="永久删除" Tag="Permanent" />
                <ComboBoxItem Content="每次询问" Tag="Ask" />
            </ComboBox>

            <!-- 发现页推荐数量 -->
            <TextBlock Text="发现页推荐数量" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="DiscoveryCountBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="10" Tag="10" />
                <ComboBoxItem Content="20" Tag="20" />
                <ComboBoxItem Content="30（默认）" Tag="30" />
                <ComboBoxItem Content="50" Tag="50" />
                <ComboBoxItem Content="100" Tag="100" />
            </ComboBox>

            <!-- 关闭窗口行为 -->
            <TextBlock Text="关闭窗口时" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="CloseBehaviorBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="每次询问（默认）" Tag="Ask" />
                <ComboBoxItem Content="直接退出" Tag="Exit" />
                <ComboBoxItem Content="最小化到托盘" Tag="Tray" />
            </ComboBox>

            <!-- 数据备份 -->
            <TextBlock Text="数据备份" FontWeight="Bold" Margin="0,0,0,6" />

            <!-- 备份目录（可配置，如 U 盘） -->
            <TextBlock Text="备份目录" FontWeight="Bold" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0" Click="OnOpenBackupDir" />
                <Button DockPanel.Dock="Right" Content="恢复默认" Margin="8,0,0,0" Click="OnResetBackupDir" />
                <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseBackupDir" />
                <TextBox x:Name="BackupDirBox" />
            </DockPanel>
            <TextBlock Text="（留空或「恢复默认」则备份到程序数据目录；可改成 U 盘等位置，程序会按下方间隔自动把数据备份过去。）"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- 自动备份间隔 -->
            <TextBlock Text="自动备份间隔" FontWeight="Bold" Margin="0,0,0,6" />
            <ComboBox x:Name="AutoBackupBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="关闭（仅启动时备份）" Tag="0" />
                <ComboBoxItem Content="每 15 分钟" Tag="15" />
                <ComboBoxItem Content="每 30 分钟" Tag="30" />
                <ComboBoxItem Content="每 1 小时" Tag="60" />
                <ComboBoxItem Content="每 2 小时" Tag="120" />
                <ComboBoxItem Content="每 6 小时" Tag="360" />
            </ComboBox>

            <!-- 上次备份信息 -->
            <TextBlock x:Name="LastBackupText" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock x:Name="BackupDirText" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11" />

            <!-- 数据迁移：导出 / 导入 -->
            <TextBlock Text="数据迁移（换电脑 / 备份）" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="把收藏、分类、标签、备注等所有数据打包导出到 U 盘；换新电脑后从 U 盘导入即可恢复。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="📤 导出数据…" Click="OnExportData" Width="120" Margin="0,0,8,0" />
                <Button Content="📥 导入数据…" Click="OnImportData" Width="120" />
            </StackPanel>

            <!-- 卸载软件 -->
            <Separator Margin="0,16,0,8" />
            <TextBlock Text="卸载" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="卸载程序（卸载时会询问是否保留收藏、分类、备注等数据）。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <Button Content="🗑 卸载软件" Click="OnUninstall" HorizontalAlignment="Left"
                    Background="#C0392B" Foreground="White" Width="120" BorderBrush="#C0392B" />

            <!-- 赞助开发者 -->
            <Separator Margin="0,16,0,8" />
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="如果这个软件帮到了你，欢迎请开发者喝杯咖啡 ☕。"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="你的支持是持续维护与功能更新的动力，感谢每一位用户。"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,12" />
                    <Button Content="❤️ 赞助开发者"
                            Click="OnSponsor"
                            HorizontalAlignment="Left"
                            Background="#E91E63" Foreground="White"
                            BorderBrush="#E91E63" Padding="12,6" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="保存" Width="100" Click="OnSave" Background="{DynamicResource PrimaryBrush}"
                        Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" />
                <Button Content="取消" Width="100" Margin="8,0,0,0" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
