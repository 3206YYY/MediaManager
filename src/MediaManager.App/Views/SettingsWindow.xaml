<Window x:Class="MediaManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="1000" Height="720"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- 左侧分类：选中 = 实心主色药丸；悬停 = 浅一层的面板色（浅/深主题都成立） -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="txt" Property="Foreground" Value="White" />
                                <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 每个设置块的标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- 说明小字 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 一组设置的白色卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!--
        下拉框统一宽度。
        ⚠ 必须 BasedOn 主题里的隐式 ComboBox 样式：一旦在控件上显式 Setting Style，
        WPF 就不再套用隐式样式，会退回系统默认的白底模板 —— 深色主题下就是白块 + 看不见的字。
        -->
        <Style x:Key="FieldCombo" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>

        <!--
        快捷键胶囊的宿主：只保留点击 / 悬停语义，外观完全由代码画（Grid + 两个 Rectangle）。
        ⚠ 不要退回「ControlTemplate + DataTrigger 绑 Tag」那套：实测在深色主题下触发器不匹配，
        虚线框和灰字都不生效，看起来跟已设置状态一模一样。状态直接改属性最省心。
        -->
        <Style x:Key="HotkeyCapsule" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <!-- 显式写 Foreground：显式 Style 会覆盖隐式 TextBlock 样式，不写就退回黑色，深色主题下几乎看不见 -->
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧分类 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="设置" FontSize="19" FontWeight="Bold"
                               Margin="20,20,20,12" />
                    <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersionText"
                               Margin="20,10,20,16" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectionChanged="OnNavChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="🎨  常规与外观" Tag="general" IsSelected="True" />
                        <ListBoxItem Content="⚡  媒体与性能" Tag="media" />
                        <ListBoxItem Content="🧷  系统集成" Tag="integration" />
                        <ListBoxItem Content="⌨  快捷键" Tag="hotkeys" />
                        <ListBoxItem Content="💾  备份与迁移" Tag="storage" />
                        <ListBoxItem Content="🧩  插件扩展" Tag="plugins" />
                        <ListBoxItem Content="ℹ️  关于与更新" Tag="about" />
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ 右侧内容 ============ -->
            <ScrollViewer x:Name="ContentScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,22,26,18">
                <Grid>

                    <!-- ================ 常规与外观（最常用，放第一页） ================ -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="常规与外观" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="最常改的几项都在这儿。其余分类在左侧，改完记得点右下角「保存」。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="「跟随系统」会随 Windows 的应用模式自动切换；主界面右上角也能一键切（切过之后就以你选的为准）。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <ComboBox x:Name="ThemeBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,4">
                                    <ComboBoxItem Content="跟随系统（默认）" Tag="System" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="删除行为" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="按 Delete 删除文件时怎么处理。默认进回收站，误删可以还原。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <ComboBox x:Name="DeleteBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,0">
                                    <ComboBoxItem Content="回收站（默认）" Tag="RecycleBin" />
                                    <ComboBoxItem Content="永久删除" Tag="Permanent" />
                                    <ComboBoxItem Content="每次询问" Tag="Ask" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="关闭窗口时" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="点 × 时的行为。选「最小化到托盘」后，程序会留在后台继续扫描和备份。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <ComboBox x:Name="CloseBehaviorBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,0">
                                    <ComboBoxItem Content="每次询问（默认）" Tag="Ask" />
                                    <ComboBoxItem Content="直接退出" Tag="Exit" />
                                    <ComboBoxItem Content="最小化到托盘" Tag="Tray" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="「发现」页每次推多少张" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="发现页会从你的库里随机挑一批还没被看到的图片/视频推给你。数量越大，每次刷新的惊喜越多，但也更吃内存。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <ComboBox x:Name="DiscoveryCountBox" Style="{StaticResource FieldCombo}" Margin="0,0,0,0">
                                    <ComboBoxItem Content="10" Tag="10" />
                                    <ComboBoxItem Content="20" Tag="20" />
                                    <ComboBoxItem Content="30（默认）" Tag="30" />
                                    <ComboBoxItem Content="50" Tag="50" />
                                    <ComboBoxItem Content="100" Tag="100" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 媒体与性能 ================ -->
                    <StackPanel x:Name="PageMedia" Visibility="Collapsed">
                        <TextBlock Text="媒体与性能" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="缩略图生成、视频抽帧相关。一般保持默认就好。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="缩略图并发数" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="同时解码多少张缩略图。调高在机械硬盘/网络盘上反而更慢，SSD 可以适当调高。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <!-- ⚠ 必须 Stretch：DockPanel/Grid 设成 Left 时按内容宽度测量，
                                     Slider 没有宽度就只剩 14px 的滑块本身，鼠标根本拖不动。 -->
                                <DockPanel MaxWidth="420" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="ConcurrencyText" DockPanel.Dock="Right" Width="42"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="8"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            Margin="0,0,10,0"
                                            ValueChanged="OnConcurrencyChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="缩略图缓存" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0"
                                            Click="OnOpenCacheDir" />
                                    <TextBox x:Name="CacheDirBox" IsReadOnly="True"
                                             Background="{DynamicResource SidebarBrush}" />
                                </DockPanel>

                                <Border Background="{DynamicResource SidebarBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="🧹 清理缓存" VerticalAlignment="Center"
                                                Margin="12,0,0,0" Click="OnCleanCache" />
                                        <StackPanel>
                                            <TextBlock x:Name="CacheSizeText" Text="正在统计…" FontWeight="SemiBold" />
                                            <TextBlock Text="清理后，缩略图会在您浏览时自动重新生成；原始图片/视频不会受任何影响。"
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="视频播放" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="RememberVideoModeBox" FontWeight="SemiBold"
                                          Content="记住上次选择的播放模式" Margin="0,2,0,0" />
                                <TextBlock Text="关掉后，每次打开视频都从「播完暂停」开始，不沿用上次选的列表循环/单曲循环。音量与静音仍然会记住。"
                                           Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="FFmpeg 路径" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="用来给视频抽封面帧。安装包已内置，通常不用改；留空则自动探测。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <DockPanel MaxWidth="620" HorizontalAlignment="Stretch">
                                    <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0"
                                            Click="OnBrowseFfmpeg" />
                                    <TextBox x:Name="FfmpegBox" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 系统集成 ================ -->
                    <StackPanel x:Name="PageIntegration" Visibility="Collapsed">
                        <TextBlock Text="系统集成" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="让媒体管理器和 Windows 资源管理器配合得更好。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="资源管理器右键菜单" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="ShellIntegrationBox" FontWeight="SemiBold"
                                          Content="在右键菜单里添加「用媒体管理器打开」"
                                          Click="OnShellIntegrationClick" Margin="0,2,0,0" />
                                <TextBlock Text="勾选后，在 Windows 里右键点任意图片即可直接用本程序打开（只写入当前用户，不需要管理员权限）。"
                                           Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                <TextBlock x:Name="ShellIntegrationStateText" Style="{StaticResource Hint}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="数据目录" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="数据库、缩略图缓存都在这儿。由便携模式决定，无法直接修改；换电脑请用「备份与迁移」里的导出/导入。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0"
                                            Click="OnOpenDataDir" />
                                    <TextBox x:Name="DataDirBox" IsReadOnly="True"
                                             Background="{DynamicResource SidebarBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 快捷键 ================ -->
                    <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                        <TextBlock Text="快捷键" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="全局快捷键：程序缩在托盘里、窗口在后台时也能用。点右边的按键框，再按下你想要的组合键即可。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="可以单独用 F1~F24；其它键必须搭配 Ctrl / Alt / Shift / Win。录键时按 Esc 取消，按 Delete 清除。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,14" />
                                <!-- 具体行由 HotkeyActions 生成：文案与存库键只有一份，不会写着写着对不上 -->
                                <StackPanel x:Name="HotkeyRows" />
                                <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="几点说明" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10">
                                    <Run Text="1." /> 保存后立即生效，不用重启；<LineBreak />
                                    <Run Text="2." /> 提示「已被其它程序占用」就换一个组合，截图 / 录屏 / 输入法工具最容易撞；<LineBreak />
                                    <Run Text="3." /> Win 键的组合有一部分被 Windows 自己占用，注册会失败；<LineBreak />
                                    <Run Text="4." /> 便携版换电脑时快捷键跟着数据库一起走。
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="恢复默认" Click="OnHotkeyRestoreDefaults" />
                                    <Button Content="全部清除" Click="OnHotkeyClearAll" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 备份与迁移 ================ -->
                    <StackPanel x:Name="PageStorage" Visibility="Collapsed">
                        <TextBlock Text="备份与迁移" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="收藏、分类、标签、备注、浏览记录都在数据库里；照片和视频本身不会被复制，只备份「你对它们做的整理」。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="备份目录" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="留空或「恢复默认」则备份到程序数据目录；可改成 U 盘等位置，程序会按下方间隔自动备份过去。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="📂 打开" Margin="8,0,0,0" Click="OnOpenBackupDir" />
                                    <Button DockPanel.Dock="Right" Content="默认" Margin="8,0,0,0" Click="OnResetBackupDir" />
                                    <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseBackupDir" />
                                    <TextBox x:Name="BackupDirBox" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动备份间隔" Style="{StaticResource SectionTitle}" />
                                <ComboBox x:Name="AutoBackupBox" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="关闭（仅启动时备份）" Tag="0" />
                                    <ComboBoxItem Content="每 15 分钟" Tag="15" />
                                    <ComboBoxItem Content="每 30 分钟" Tag="30" />
                                    <ComboBoxItem Content="每 1 小时" Tag="60" />
                                    <ComboBoxItem Content="每 2 小时" Tag="120" />
                                    <ComboBoxItem Content="每 6 小时" Tag="360" />
                                </ComboBox>
                                <TextBlock x:Name="LastBackupText" Style="{StaticResource Hint}" Margin="0,2,0,4" />
                                <TextBlock x:Name="BackupDirText" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>

                        <!-- 🕒 历史快照（时光机）：自动备份节点 + 一键回退 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🕒 历史快照（时光机）" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="程序每次启动、以及按上面的间隔会自动存一份快照，最多保留 7 份，按时间从新到旧排列。选一个时间点就能把整个整理库退回那一刻。" />
                                <TextBlock x:Name="SnapshotSummaryText" Style="{StaticResource Hint}"
                                           Margin="0,0,0,8" />

                                <Border x:Name="SnapshotEmptyBox" Visibility="Collapsed"
                                        Background="{DynamicResource SidebarBrush}" CornerRadius="6"
                                        Padding="12,10" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="还没有自动备份节点。点下面「立即备份一次」就能生成第一个时间点。" />
                                </Border>

                                <StackPanel x:Name="SnapshotListPanel" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="📦 立即备份一次" Click="OnBackupNow" />
                                    <Button Content="📂 打开备份目录" Click="OnOpenBackupDir" Margin="8,0,0,0" />
                                    <TextBlock x:Name="SnapshotDirText" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="换电脑 / 手动备份" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="把整理数据打包成一个文件拷到 U 盘；新电脑上导入即可恢复。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📤 导出数据…" Click="OnExportData" Width="130" Margin="0,0,8,0" />
                                    <Button Content="📥 导入数据…" Click="OnImportData" Width="130" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 插件扩展 ================ -->
                    <StackPanel x:Name="PagePlugins" Visibility="Collapsed">
                        <TextBlock Text="插件扩展" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="不想塞进主程序的小功能，可以做成插件放进来。插件崩了不会影响主程序，也不会动你的原始文件。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="插件目录" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="🔄 重新扫描" Margin="8,0,0,0"
                                            Click="OnRescanPlugins" />
                                    <Button DockPanel.Dock="Right" Content="📂 打开目录" Margin="8,0,0,0"
                                            Click="OnOpenPluginDir" />
                                    <TextBox x:Name="PluginDirBox" IsReadOnly="True"
                                             Background="{DynamicResource SidebarBrush}" />
                                </DockPanel>
                                <TextBlock x:Name="PluginSummaryText" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="已安装" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                        <StackPanel x:Name="PluginListPanel" Margin="0,0,0,14" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="怎么自己写一个？" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10">
                                    1. 装 .NET 8 SDK，引用 <Run FontFamily="Consolas">MediaManager.Core.dll</Run>；
                                    2. 建一个类实现 <Run FontFamily="Consolas">IMediaManagerPlugin</Run>，
                                    在 <Run FontFamily="Consolas">Initialize</Run> 里用
                                    <Run FontFamily="Consolas">context.AddMenuAction("标题", 回调)</Run> 注册菜单；
                                    3. 编译后把 dll 丢进上面的插件目录（可再放一个 plugin.json 指定入口），重启程序即可。
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📄 看接口文档" Click="OnOpenPluginDocs" Margin="0,0,8,0" />
                                    <Button Content="🧪 示例插件模板" Click="OnOpenPluginTemplate" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================ 关于与更新 ================ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="关于与更新" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="纯本地、无广告、开源。你的照片不会离开这台电脑。"
                                   Style="{StaticResource PageSubtitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="版本" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="VersionText" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}"
                                           Margin="0,0,0,12" Text="点击下方按钮检查 GitHub 上有没有新版本。" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckUpdateButton" Content="🔄 检查更新"
                                            Click="OnCheckUpdate" Margin="0,0,8,0" />
                                    <Button Content="🌐 打开 GitHub 主页" Click="OnOpenRepository" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="赞助开发者" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="如果这个软件帮到了你，欢迎请开发者喝杯咖啡 ☕。你的支持是持续维护与功能更新的动力。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                <Button Content="❤️ 赞助开发者" Click="OnSponsor" HorizontalAlignment="Left"
                                        Background="#E91E63" Foreground="White" BorderBrush="#E91E63"
                                        Padding="12,6" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="卸载" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="卸载程序（会询问是否保留收藏、分类、备注等数据）。便携版直接删文件夹即可。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                <Button Content="🗑 卸载软件" Click="OnUninstall" HorizontalAlignment="Left"
                                        Background="#C0392B" Foreground="White" BorderBrush="#C0392B" Width="120" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============ 底部固定操作条 ============ -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="保存" Width="104" Click="OnSave"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White"
                            BorderBrush="{DynamicResource PrimaryBrush}" />
                    <Button Content="取消" Width="104" Margin="8,0,0,0" Click="OnCancel" />
                </StackPanel>
                <TextBlock x:Name="FooterHint" VerticalAlignment="Center"
                           FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="主题立即生效；其余设置保存后生效。" />
            </DockPanel>
        </Border>

        <!-- ============ 恢复数据遮罩（覆盖整窗，挡住一切点击） ============ -->
        <Grid x:Name="RestoreOverlay" Grid.RowSpan="2" Panel.ZIndex="2000"
              Visibility="Collapsed" Background="#CC000000">
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Width="320">
                    <TextBlock Text="正在恢复数据，请勿关闭软件…"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,12" />
                    <TextBlock x:Name="RestoreStepText" Text="准备中…"
                               Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
