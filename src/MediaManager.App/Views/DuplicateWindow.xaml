<Window x:Class="MediaManager.App.Views.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MediaManager.App.Controls"
        Title="查找重复文件"
        Width="760" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：状态 + 操作 -->
        <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="开始检测" Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 中间：重复组列表 -->
        <ListBox Grid.Row="1" x:Name="GroupList"
                 ItemsSource="{Binding Groups}"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource PanelBrush}" Margin="6,4" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded}" Background="Transparent"
                                          BorderThickness="0" HorizontalAlignment="Stretch" Padding="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToArrow}}" Foreground="Gray" />
                                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} 个重复文件}"
                                               FontWeight="Bold" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding SizeDisplay, StringFormat=　·　{0}/个}" Foreground="Gray" />
                                </StackPanel>
                            </ToggleButton>

                            <ItemsControl ItemsSource="{Binding Items}"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}"
                                                      Checked="OnItemChecked" Unchecked="OnItemChecked" />
                                            <Image Grid.Column="1" Width="56" Height="56" Margin="8,0"
                                                   ctl:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}"
                                                   Stretch="UniformToFill" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                <TextBlock Text="{Binding Path}" Foreground="Gray" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                <TextBlock Text="{Binding SizeDisplay}" Foreground="Gray" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部：删除 -->
        <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding DeleteSummary, StringFormat=🗑 {0}}"
                        Command="{Binding DeleteSelectedCommand}" Margin="8,0,0,0" />
                <TextBlock Text="提示：默认勾选每组除第一张外的文件（即删除重复的），可手动调整。"
                           Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
