<Window x:Class="MediaManager.App.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- 主按钮（蓝底白字，hover 仅变透明度，避免被全局 HoverBrush 盖成灰色） -->
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮（红底白字） -->
        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
            <Setter Property="Background" Value="#C0392B" />
            <Setter Property="BorderBrush" Value="#C0392B" />
        </Style>

        <!-- 次要按钮（跟随主题：浅色白底深字 / 深色深底浅字） -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 弹窗本体圆角且颜色全部跟随主题（不投影：DropShadowEffect 在低端显卡/集显上开销明显，官方已去掉） -->
    <Border Margin="0" CornerRadius="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border Grid.Row="0" Background="Transparent" Padding="18,14,12,8"
                    MouseLeftButtonDown="OnHeaderDrag">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕"
                            Width="26" Height="26" Padding="0" FontSize="12"
                            Style="{StaticResource DialogButton}"
                            MinWidth="0" VerticalAlignment="Top"
                            Click="OnCancelButtonClick" ToolTip="关闭（Esc）" />
                    <TextBlock x:Name="IconText" DockPanel.Dock="Left" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 正文 -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Margin="18,2,18,18" TextWrapping="Wrap" FontSize="13"
                       LineHeight="21" Foreground="{DynamicResource TextBrush}" />

            <!-- 底部：可选复选框 + 按钮组 -->
            <StackPanel Grid.Row="2" Margin="18,0,18,16">
                <CheckBox x:Name="RememberBox" Content="记住我的选择，下次不再提示"
                          Margin="0,0,0,14" Visibility="Collapsed"
                          Foreground="{DynamicResource TextBrush}" />
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
