<Window x:Class="MediaManager.App.Views.Dialogs.SaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="另存为"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="SavePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="18,14,18,16">
            <TextBlock Text="另存为" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}" />

            <TextBlock Text="保存到" FontSize="11" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource SaveButton}"
                        MinWidth="72" Padding="10,5" Margin="8,0,0,0" Click="OnBrowse" />
                <TextBox x:Name="PathBox" MinHeight="30" VerticalContentAlignment="Center" />
            </DockPanel>

            <TextBlock Text="格式" FontSize="11" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="FormatCombo" Margin="0,0,0,10" SelectionChanged="OnFormatChanged">
                <ComboBoxItem Content="PNG（无损，支持透明）" Tag="png" />
                <ComboBoxItem Content="JPEG（体积小，可调质量）" Tag="jpeg" />
                <ComboBoxItem Content="WebP（体积更小，可调质量）" Tag="webp" />
                <ComboBoxItem Content="BMP（无压缩）" Tag="bmp" />
            </ComboBox>

            <DockPanel Margin="0,0,0,2">
                <TextBlock x:Name="QualityText" DockPanel.Dock="Right" Text="92"
                           Width="34" TextAlignment="Right" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="质量（仅 JPEG / WebP）" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
            <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="92"
                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,6"
                    ValueChanged="OnQualityChanged" />

            <TextBlock Text="编辑结果会写成新文件，原图不会被修改。" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="保存" Style="{StaticResource SavePrimaryButton}"
                        IsDefault="True" Click="OnSave" />
                <Button Content="取消" Style="{StaticResource SaveButton}"
                        Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
