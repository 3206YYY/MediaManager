<Window x:Class="MediaManager.App.Views.Dialogs.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量重命名"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NormalButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DragArea" Margin="0" CornerRadius="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

        <StackPanel Margin="18,16,18,16">
            <TextBlock Text="批量重命名" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="CountText" FontSize="12" Margin="0,4,0,14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名前缀" VerticalAlignment="Center"
                           Margin="0,0,10,10" Foreground="{DynamicResource TextBrush}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrefixBox" MinHeight="30" Margin="0,0,16,10"
                         TextChanged="OnInputChanged" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="起始序号" VerticalAlignment="Center"
                           Margin="0,0,10,10" Foreground="{DynamicResource TextBrush}" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="StartBox" MinHeight="30" Margin="0,0,0,10"
                         Text="1" TextChanged="OnInputChanged" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="序号位数" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DigitsBox" Margin="0,0,16,0"
                          SelectionChanged="OnDigitsChanged">
                    <ComboBoxItem Content="1 位（1, 2, 3）" Tag="1" />
                    <ComboBoxItem Content="2 位（01, 02）" Tag="2" />
                    <ComboBoxItem Content="3 位（001, 002）" Tag="3" IsSelected="True" />
                    <ComboBoxItem Content="4 位（0001）" Tag="4" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="后缀" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="SuffixBox" MinHeight="30"
                         TextChanged="OnInputChanged" />
            </Grid>

            <!-- 预览 -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="预览" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="PreviewText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="WarnText" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="#C0392B" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="开始重命名" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="OnOk" />
                <Button Content="取消" Style="{StaticResource NormalButton}" IsCancel="True"
                        Margin="8,0,0,0" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
