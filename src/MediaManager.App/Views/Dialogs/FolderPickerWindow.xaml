<Window x:Class="MediaManager.App.Views.Dialogs.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择媒体文件夹" Width="1060" Height="720"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 快捷入口（全鼠标） -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="🏠 用户目录" Click="OnHome" Margin="0,0,6,0" />
            <Button Content="🖥 桌面" Click="OnDesktop" Margin="0,0,6,0" />
            <Button Content="📄 文档" Click="OnDocuments" Margin="0,0,6,0" />
            <Button Content="⬇ 下载" Click="OnDownloads" />
        </StackPanel>

        <!-- 路径 + 上一级 -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="⬆ 上一级" Click="OnUp" Margin="8,0,0,0" />
            <TextBox x:Name="PathBox" IsReadOnly="True" FontSize="14" />
        </DockPanel>

        <!-- 左侧目录树 -->
        <TreeView x:Name="FolderTree" Grid.Row="2" Grid.Column="0"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource TextBrush}" />

        <!-- 右侧缩略图网格：图片显示真缩略图，其它类型显示图标 -->
        <ListBox x:Name="ItemList" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="132" Margin="6">
                        <Border Width="120" Height="120" Background="{DynamicResource PanelBrush}" CornerRadius="6">
                            <Grid>
                                <Image Source="{Binding DisplayImage}" Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Glyph}" FontSize="46"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0" FontSize="13" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部 -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="选择此文件夹" Width="130" Click="OnConfirm"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" />
                <Button Content="取消" Width="90" Margin="8,0,0,0" Click="OnCancel" />
            </StackPanel>
            <TextBlock x:Name="HintText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
