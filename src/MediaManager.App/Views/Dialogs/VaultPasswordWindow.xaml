<Window x:Class="MediaManager.App.Views.Dialogs.VaultPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="私密空间"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="20,16,20,18">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="MessageText" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                       Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel x:Name="OldRow" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="原密码" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <PasswordBox x:Name="OldPasswordBox" MinHeight="32" Padding="8,4" MaxLength="64" />
            </StackPanel>

            <StackPanel x:Name="MainRow" Margin="0,0,0,10">
                <TextBlock x:Name="MainLabel" Text="密码" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <PasswordBox x:Name="PasswordBox1" MinHeight="32" Padding="8,4" MaxLength="64" />
            </StackPanel>

            <StackPanel x:Name="ConfirmRow" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmLabel" Text="再输一次" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <PasswordBox x:Name="PasswordBox2" MinHeight="32" Padding="8,4" MaxLength="64" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="#E5484D" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="解锁" Style="{StaticResource DialogPrimaryButton}"
                        IsDefault="True" Click="OnOk" />
                <Button Content="取消" Style="{StaticResource DialogButton}"
                        Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
