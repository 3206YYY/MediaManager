<Window x:Class="MediaManager.App.Views.Dialogs.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="媒体管理器"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        KeyDown="OnWindowKeyDown"
        MouseLeftButtonDown="OnDragArea">

    <Window.Resources>
        <!-- 两张卡片：整块可点，不是那种要瞄准的小按钮 -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <!-- 外层留白给阴影用：AllowsTransparency 下 Effect 会被窗口边界裁掉。
         底色用 BgBrush 而不是 PanelBrush：卡片本身是 PanelBrush，浅色主题下
         两者都是纯白，会变成「白卡片叠白背景」，只剩 1px 边框能看出来。 -->
    <Border Margin="14" CornerRadius="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.26" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,22,26,20">
            <TextBlock Text="先问一句，以后不烦你"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />

            <TextBlock Margin="0,7,0,18" TextWrapping="Wrap" LineHeight="20" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="你主要用媒体管理器做什么？左边侧栏留几项，你自己定。选完随时能在「设置 → 界面」里改回来。" />

            <Button x:Name="SimpleButton" Style="{StaticResource ChoiceCard}" Click="OnChooseSimple"
                    AutomationProperties.Name="只看图和视频">
                <StackPanel>
                    <TextBlock Text="🖼  我只想看图和视频" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardDesc}"
                               Text="打开就是照片墙，双击看大图，左右键翻页。侧栏只留「发现 / 全部 / 收藏 / 文件夹」。" />
                </StackPanel>
            </Button>

            <Button x:Name="FullButton" Style="{StaticResource ChoiceCard}" Click="OnChooseFull"
                    AutomationProperties.Name="整理和记录">
                <StackPanel>
                    <TextBlock Text="🧰  我要整理照片、写日记" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardDesc}"
                               Text="在上面基础上，再加 日记、私密空间、分类与标签、最近查看 / 最近添加、回收站 —— 一整套整理工具。" />
                </StackPanel>
            </Button>

            <TextBlock Margin="2,8,2,0" TextWrapping="Wrap" LineHeight="18" FontSize="11.5"
                       Opacity="0.75"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="拿不准就选第一个：其它功能只是藏起来，不是删掉，教程和多出来的选项都不会消失。" />
        </StackPanel>
    </Border>
</Window>
