<Window x:Class="MediaManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaManager.App.ViewModels"
        xmlns:core="clr-namespace:MediaManager.Core.Models;assembly=MediaManager.Core"
        xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:ctl="clr-namespace:MediaManager.App.Controls"
        mc:Ignorable="d"
        Title="媒体管理器" Height="800" Width="1400"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Closing="OnClosing"
        KeyDown="OnKeyDown"
        InputMethod.IsInputMethodEnabled="False"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.Resources>
        <!-- 侧边栏可折叠分组标题：库 / 文件夹 / 标签 / 分类共用同一套视觉与悬停反馈 -->
        <Style x:Key="SidebarSectionHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="6,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏文字：统一继承宿主（ListBoxItem / ToggleButton）的 Foreground。
             全局隐式 TextBlock 样式会把 Foreground 写死成 TextBrush，正好盖掉
             宿主 hover/selected 时设的 PrimaryBrush —— 那才是「悬停没反应」的真正原因。
             这里在 DataTemplate / 内联内容里给个 local value，把颜色拉回宿主。 -->
        <Style x:Key="SidebarText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
        </Style>

        <!-- 折叠箭头：紧跟标题文字，不吃宿主颜色以外的任何设定 -->
        <Style x:Key="SidebarChevron" TargetType="TextBlock" BasedOn="{StaticResource SidebarText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,8">
            <DockPanel>
                <TextBox DockPanel.Dock="Left" Width="240" Margin="0,0,10,0"
                         InputMethod.IsInputMethodEnabled="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索（Ctrl+F）" />
                <Button DockPanel.Dock="Left" Content="🔍" Margin="0,0,10,0"
                        Command="{Binding SearchCommand}" />

                <!-- 顶部类型筛选（多选：全部 / 全不选 / 选几个） -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="2,0,4,0">
                    <ToggleButton x:Name="TypeFilterToggle" Content="类型 ▾" Style="{StaticResource FilterToggleStyle}"
                                  Margin="0,0,6,0" ToolTip="按类型筛选（可多选）" />
                    <Popup x:Name="TypeFilterPopup"
                           PlacementTarget="{Binding ElementName=TypeFilterToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=TypeFilterToggle, Mode=TwoWay}">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="全部" Click="OnSelectAllTypes" Margin="0,0,6,0" />
                                    <Button Content="全不选" Click="OnClearAllTypes" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TypeFilterOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Margin="0,3"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton Content="📝 已编辑" Style="{StaticResource FilterToggleStyle}"
                                  IsChecked="{Binding EditedOnly}" Margin="0,0,6,0"
                                  ToolTip="只显示已编辑生成的副本" />
                </StackPanel>

                <!-- 私密空间是独立窗口（点侧栏「🔒 私密空间」打开），主界面不承载私密视图 -->
                <Button DockPanel.Dock="Right" Content="⚙ 设置" Margin="10,0,0,0" Click="OnSettings" />
                <!-- 最常用的设置直接放主界面：一键切深浅色（其余收进设置页侧边栏分类） -->
                <!-- 用矢量图标而不是彩色 emoji：和旁边按钮的线条图标风格一致，
                     也不受 emoji 字形行框影响，18x18 的 Grid 里天然居中 -->
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Width="36" Height="30" Padding="0"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Click="OnThemeToggleClick" ToolTip="切换深色 / 浅色模式">
                    <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox x:Name="MoonIconHost" Stretch="Uniform">
                            <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                        <Viewbox x:Name="SunIconHost" Stretch="Uniform" Visibility="Collapsed">
                            <Path Data="M12 6.5A5.5 5.5 0 1 0 12 17.5 5.5 5.5 0 1 0 12 6.5Z M12 1.5V4.5 M12 19.5V22.5 M1.5 12H4.5 M19.5 12H22.5 M4.6 4.6L6.7 6.7 M17.3 17.3L19.4 19.4 M4.6 19.4L6.7 17.3 M17.3 6.7L19.4 4.6"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                    </Grid>
                </Button>
                <!-- 插件入口：默认隐藏，只有真的加载到插件才出现（没插件时不占地方、不误导） -->
                <Button x:Name="PluginButton" DockPanel.Dock="Right" Content="🧩 插件" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="OnPluginMenuClick"
                        ToolTip="由插件提供的扩展功能" />
                <Button DockPanel.Dock="Right" Content="🔄 刷新" Command="{Binding RefreshCommand}" />
                <Button DockPanel.Dock="Right" Content="🗂 去重" Click="OnFindDuplicates" />
                <Button DockPanel.Dock="Right" Content="扫描" Command="{Binding ScanAllCommand}" />
                <Button DockPanel.Dock="Right" Content="👁 快速查看" Margin="0,0,10,0" Click="OnOpenFile"
                        ToolTip="直接打开单个文件预览，不加入媒体库（也可把文件拖进窗口）" />
                <Button DockPanel.Dock="Right" Content="＋ 添加文件夹" Margin="0,0,10,0"
                        Command="{Binding AddFolderCommand}"
                        ToolTip="把一个文件夹加入媒体库并扫描里面的媒体文件" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="缩略图大小：" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Width="120" Minimum="80" Maximum="320" Value="{Binding ThumbnailSize}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧导航 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <ToggleButton x:Name="NavToggle" IsChecked="True" Margin="8,8,8,4"
                                      Click="OnToggleSection" Tag="Nav"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起库视图">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NavChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 库" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                            </StackPanel>
                        </ToggleButton>
                        <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}">
                            <ListBoxItem Tag="discovery" PreviewMouseLeftButtonDown="OnNavClick" IsSelected="True">
                                <TextBlock Text="✨ 发现" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="all" PreviewMouseLeftButtonDown="OnNavClick">
                                <TextBlock Text="🏠 全部媒体" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="favorites" PreviewMouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐ 收藏" Style="{StaticResource SidebarText}" />
                                    <TextBlock Text="{Binding DataContext.FavoriteCount, StringFormat=( {0} ), RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource SidebarText}" Opacity="0.65" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="unfiled" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📥 未分类" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="recent-view" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🕒 最近查看" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="recent" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🕘 最近添加" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="diary" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📔 日记" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="trash" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🗑 最近删除" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <!-- 私密空间：默认点一下直接进（没设密码时就是一层隐藏）；设过密码则先弹解锁窗 -->
                            <ListBoxItem x:Name="VaultNavItem" Tag="vault" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 私密空间" Style="{StaticResource SidebarText}" />
                                    <TextBlock Text="{Binding PrivateCount, StringFormat=( {0} )}"
                                               Opacity="0.65" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SidebarText}">
                                                <Style.Triggers>
                                                    <!-- 空保险箱不显示 ( 0 )，免得像「坏了」 -->
                                                    <DataTrigger Binding="{Binding PrivateCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- 分类：v1.3.2 起是唯一的归类维度（收藏夹已并入），也是拖拽归类的落点 -->
                        <!-- 极简模式整组隐藏：分类对轻度用户是「多出来的一套概念」，藏掉不影响文件 -->
                        <!-- 位置在「文件夹」之前：分类是用户自己划的「分区」，比系统路径更常点 -->
                        <ToggleButton x:Name="CategoryToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Category"
                                      Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起分类分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 分类" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                                <TextBlock Text="{Binding CategoryCount, StringFormat=( {0} )}" FontSize="11"
                                           Style="{StaticResource SidebarText}" Opacity="0.65"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="CategoryAddPanel" Orientation="Horizontal" Margin="8,0,8,4"
                                    Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                            <Button Content="＋ 新建分类" Command="{Binding AddCategoryCommand}" />
                        </StackPanel>
                        <ListBox x:Name="CategoryListBox" BorderThickness="0" Background="Transparent"
                                 Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                 ItemsSource="{Binding CategoryItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnCategorySelectionChanged"
                                 PreviewMouseLeftButtonDown="OnReorderMouseDown"
                                 PreviewMouseMove="OnReorderMouseMove"
                                 PreviewMouseLeftButtonUp="OnReorderMouseUp"
                                 AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop"
                                 Tag="Category">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SidebarText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名" Click="OnRenameCategoryMenu" />
                                    <Separator />
                                    <MenuItem Header="删除" Click="OnDeleteCategoryMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <ToggleButton x:Name="FolderToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Folder"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起文件夹分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FolderChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 文件夹" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                            </StackPanel>
                        </ToggleButton>
                        <ListBox x:Name="FolderListBox" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding FolderItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnFolderSelectionChanged">
                            <ListBox.ItemTemplate>
                                <!-- 两级显示：末级目录名 + 盘符/上级目录小字。
                                     以前直接放整条路径，侧栏宽度不够被截成
                                     「C:\Users\xxx\Videos\Capt…」，两个目录看着一模一样 -->
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding ToolTipText}">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SidebarText}" />
                                        <TextBlock Text="{Binding SubTitle}" TextTrimming="CharacterEllipsis"
                                                   FontSize="10" Opacity="0.55" Margin="0,1,0,0"
                                                   Style="{StaticResource SidebarText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开所在位置" Click="OnOpenFolderMenu" />
                                    <Separator />
                                    <MenuItem Header="从库中移除" Click="OnRemoveFolderMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <ToggleButton x:Name="TagToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Tag"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起标签分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TagChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 标签" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                                <TextBlock Text="{Binding TagCount, StringFormat=( {0} )}" FontSize="11"
                                           Style="{StaticResource SidebarText}" Opacity="0.65"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="TagAddPanel" Orientation="Horizontal" Margin="8,0,8,4">
                            <Button Content="＋ 新建标签" Command="{Binding AddTagCommand}" />
                        </StackPanel>
                        <ListBox x:Name="TagListBox" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding TagItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnTagSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnReorderMouseDown"
                                 PreviewMouseMove="OnReorderMouseMove"
                                 PreviewMouseLeftButtonUp="OnReorderMouseUp"
                                 AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop"
                                 Tag="Tag">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SidebarText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名" Click="OnRenameTagMenu" />
                                    <Separator />
                                    <MenuItem Header="删除" Click="OnDeleteTagMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 中间缩略图网格 ===== -->
            <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 发现页工具栏 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,8"
                        Visibility="{Binding IsDiscoveryView, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="🎲 换一批 (R)"
                                Command="{Binding RefreshDiscoveryCommand}" Margin="10,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="推荐池：" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox DockPanel.Dock="Left" Width="160"
                                  ItemsSource="{Binding DiscoveryPoolOptions}"
                                  SelectedIndex="{Binding DiscoveryPoolIndex}" />
                        <ComboBox x:Name="DiscoveryPoolCombo" DockPanel.Dock="Left" Width="160" Margin="10,0,0,0"
                                  ItemsSource="{Binding DiscoveryPoolCategories}"
                                  DisplayMemberPath="Name"
                                  Visibility="{Binding DiscoveryPoolIndex, Converter={StaticResource DiscoveryPoolVis}}"
                                  SelectionChanged="OnDiscoveryCategoryChanged" />
                    </DockPanel>
                </Border>

                <!-- 发现页：空库欢迎引导 -->
                <Border Grid.Row="1" Background="{DynamicResource BgBrush}"
                        Panel.ZIndex="10"
                        Visibility="{Binding DiscoveryShowWelcome, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="👋 欢迎使用媒体管理器" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="先添加一个媒体文件夹，开始整理你的图片和视频"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Button Content="＋ 添加文件夹" HorizontalAlignment="Center" Padding="20,8"
                                FontSize="14" Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <!-- 发现页：首次提示 -->
                <Border Grid.Row="1" Background="{DynamicResource BgBrush}"
                        Visibility="{Binding DiscoveryShowHint, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        IsHitTestVisible="False">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="{DynamicResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,10">
                        <TextBlock Text="这是随机挑出来的 30 张。按 R 换一批，按 F 收藏喜欢的。"
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Border>

                <ListBox x:Name="ThumbList"
                         Grid.Row="1"
                         ItemsSource="{Binding MediaItems}"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         SelectionMode="Extended"
                         MouseDoubleClick="OnItemDoubleClick"
                         PreviewMouseLeftButtonDown="OnThumbListMouseDown"
                         PreviewMouseMove="OnThumbListMouseMove"
                         PreviewMouseLeftButtonUp="OnThumbListMouseUp"
                         PreviewMouseWheel="OnThumbListPreviewMouseWheel"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="OnContextMenuOpened">
                            <MenuItem Header="⭐ 收藏/取消收藏 (F)" Click="OnFavoriteMenu" />
                            <Separator />
                            <MenuItem x:Name="CategoryMenu" Header="📁 分类" />
                            <Separator />
                            <MenuItem Header="📂 用系统默认程序打开 (Ctrl+O)" Click="OnOpenExternallyMenu" />
                            <MenuItem Header="📂 打开所在位置 (Ctrl+Enter)" Click="OnOpenLocationMenu" />
                            <MenuItem Header="重命名 (F2)" Click="OnRenameMenu" />
                            <MenuItem x:Name="BatchRenameMenu" Header="✏ 批量重命名…" Click="OnBatchRenameMenu" />
                            <MenuItem x:Name="BatchExportMenu" Header="📤 批量导出 / 统一尺寸…" Click="OnBatchExportMenu" />
                            <MenuItem Header="删除到回收站 (Delete)" Click="OnDeleteMenu" />
                            <Separator />
                            <MenuItem x:Name="MoveIntoVaultMenu" Header="🔒 移入私密空间" Click="OnMoveIntoVaultMenu" />
                            <MenuItem x:Name="AddToDiaryMenu" Header="📔 写进日记" Click="OnAddToDiaryMenu" />
                            <Separator />
                            <MenuItem Header="打星">
                                <MenuItem Header="⭐ 1" Click="OnRateMenu" Tag="1" />
                                <MenuItem Header="⭐⭐ 2" Click="OnRateMenu" Tag="2" />
                                <MenuItem Header="⭐⭐⭐ 3" Click="OnRateMenu" Tag="3" />
                                <MenuItem Header="⭐⭐⭐⭐ 4" Click="OnRateMenu" Tag="4" />
                                <MenuItem Header="⭐⭐⭐⭐⭐ 5" Click="OnRateMenu" Tag="5" />
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vw:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MinWidth="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MinHeight="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MaxWidth="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MaxHeight="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Margin="4">
                                <Grid.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ResolutionDisplay}" Foreground="#BBBBBB" FontSize="11" />
                                            <TextBlock Text="{Binding SizeDisplay}" Foreground="#BBBBBB" FontSize="11" />
                                            <TextBlock Text="{Binding Note, StringFormat=备注：{0}}"
                                                       TextWrapping="Wrap" MaxWidth="260" FontSize="11"
                                                       Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                    </ToolTip>
                                </Grid.ToolTip>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid ClipToBounds="True">
                                        <!-- 骨架屏：缩略图未就绪时的柔和底色 + 极简照片占位标识。
                                             刻意放在 Image **下面**（不是上面）：图片加载完会把它完全盖住，
                                             这样就不需要任何逐项的 Visibility 绑定，也就没有逐项布局重算。
                                             纯静态图形、零动画 —— 虚拟化列表里才不会掉帧。 -->
                                        <Border Background="{DynamicResource SkeletonBrush}"
                                                Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}">
                                            <Grid Width="32" Height="26" Opacity="0.2"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="1.2" CornerRadius="3" />
                                                <Ellipse Width="4.2" Height="4.2"
                                                         Fill="{DynamicResource TextSecondaryBrush}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Margin="5,4,0,0" />
                                                <Path Data="M0,10 L6,2 L10.5,6.5 L13.5,3.5 L20,10 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Stretch="Fill" Margin="6,11,6,4" />
                                            </Grid>
                                        </Border>
                                        <Image ctl:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}"
                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                        <Border Background="#22000000"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="▶" Foreground="White" FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                        <!-- 非视觉类型（文档/压缩包/音频）：彩色矢量类型图标。
                                             以前这里是 emoji（📄 🗜️ 🎵），而 emoji 在 WPF 里能不能出彩色
                                             完全看系统字体：很多机器回落到 Segoe UI Symbol 的单色字形，
                                             看着就像「图标没加载出来」。现在改成纯矢量绘制，任何机器一致。
                                             宽高跟着格子大小走（96:118 的稿，×0.46 / ×0.565 保持比例），
                                             拖缩略图滑块时不会变形。 -->
                                        <ctl:FileTypeIconView Icon="{Binding FileIcon}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.46}"
                                                              Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.565}"
                                                              Visibility="{Binding IsNonVisual, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="{Binding FileIcon.Description}" />
                                        <Border Background="#E6C627" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" CornerRadius="0,0,0,8"
                                                Padding="5,1"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="★" FontSize="13" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                        <Border Background="#2E7DD1" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" CornerRadius="0,0,8,0"
                                                Padding="5,1"
                                                ToolTip="{Binding CategoryNames, StringFormat=分类：{0}}"
                                                Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="📁" FontSize="12" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- 悬停快捷操作条 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Margin="0,0,4,4" Opacity="0">
                                    <Button Content="⭐" Width="24" Height="24" Padding="0" Margin="2"
                                            FontSize="12" ToolTip="收藏"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="🏷" Width="24" Height="24" Padding="0" Margin="2"
                                            FontSize="12" ToolTip="加标签（右键菜单）" />
                                    <Button Content="📁" Width="24" Height="24" Padding="0" Margin="2"
                                            FontSize="12" ToolTip="加分类（右键菜单）" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                                <!-- 文件名压在图上的底部渐变遮罩：白字压浅色图片也能看清（浅色主题下尤其明显） -->
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.6" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#A6000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Margin="4" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 分页：加载更多（方案 A）。只在还有未加载项时显示 -->
                <Button Grid.Row="1"
                        Content="{Binding LoadMoreText}"
                        Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,20" Padding="18,8" FontSize="13"
                        Panel.ZIndex="20" Opacity="0.95"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}"
                        ToolTip="加载下一页（每页 2000 项）" />

                <!-- 框选矩形层 -->
                <Border x:Name="SelectionRect"
                        Grid.Row="1"
                        BorderBrush="#4A90D9" BorderThickness="1"
                        Background="#334A90D9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>

            <!-- ===== 右侧详情面板 ===== -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{Binding DetailName}" FontWeight="Bold" FontSize="16"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DetailDate}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                        <Separator Margin="0,12" />

                        <Button Content="⭐ 收藏" HorizontalAlignment="Stretch"
                                Command="{Binding ToggleFavoriteCommand}"
                                CommandParameter="{Binding SelectedItem}" />

                        <Separator Margin="0,12" />

                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="所属分类" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="＋ 加入" MinWidth="58" Padding="8,1"
                                    FontSize="11.5"
                                    ToolTip="把当前文件加入一个或多个分类（可连续勾选）"
                                    Click="OnDetailAddCategoryClick" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SelectedCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button Content="✕" Width="20" Height="20" Padding="0" DockPanel.Dock="Right"
                                                ToolTip="移出该分类"
                                                Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 一个都没加时给个提示，避免「空一块」看着像坏了 -->
                        <TextBlock Text="还没有归入任何分类" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- 没选中任何文件时别显示这句：面板本身是常驻的，
                                             空选状态下说「还没有归入任何分类」会让人以为是个坏掉的文件 -->
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Separator Margin="0,12" />

                        <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBox x:Name="NoteBox"
                                 InputMethod.IsInputMethodEnabled="True"
                                 Text="{Binding NoteEditor, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="40" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewMouseWheel="OnNoteBoxPreviewMouseWheel" />
                        <Button Content="💾 保存备注" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Command="{Binding SaveNoteCommand}" />

                        <Separator Margin="0,12" />

                        <TextBlock Text="EXIF 信息" FontWeight="Bold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ExifItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key, StringFormat={}{0}: }" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 删除撤销提示条（底部居中，5 秒后自动消失） ============ -->
        <!-- 发现新文件提示（右下角） -->
        <Border Grid.Row="1" Panel.ZIndex="901"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,60" Padding="14,11" CornerRadius="8" MaxWidth="380"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                Visibility="{Binding IsNewFilesToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NewFilesToastText}" VerticalAlignment="Center"
                               Margin="8,0,8,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding NewFilesSecondsLeft, Mode=OneWay}" /><Run Text=" 秒后自动加入" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                    <Button Content="加入库" Command="{Binding JoinNewFilesCommand}" MinWidth="72"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White"
                            BorderBrush="{DynamicResource PrimaryBrush}" />
                    <Button Content="忽略" Command="{Binding IgnoreNewFilesCommand}" MinWidth="60"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作轻提示（1.8 秒自动消失）：只用来说结果，不带按钮 -->
        <Border Grid.Row="1" Panel.ZIndex="899"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,74" Padding="12,7" CornerRadius="14"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{Binding IsActionToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ActionToastText}" FontSize="12.5" />
        </Border>

        <Border Grid.Row="1" Panel.ZIndex="900"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="14,9" CornerRadius="8"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding IsUndoToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗑" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UndoToastText}" VerticalAlignment="Center"
                           Margin="8,0,10,0" FontSize="13" />
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding UndoSecondsLeft, Mode=OneWay}" /><Run Text=" 秒" />
                </TextBlock>
                <Button Content="撤销" Command="{Binding UndoDeleteCommand}"
                        Margin="14,0,0,0" MinWidth="64"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" />

                <!-- 缩略图加载指示：队列清空后自动隐藏。
                     数据来自 ThumbnailLoadMonitor 的 250ms 聚合，不订阅逐图事件（否则 UI 线程会被回调淹没）。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="{Binding ThumbLoading.IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="68" Height="6" Maximum="100" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Value="{Binding ThumbLoading.Progress, Mode=OneWay}" />
                    <TextBlock Text="{Binding ThumbLoading.StatusText}" VerticalAlignment="Center"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 调试帧率：启动前设环境变量 MM_FPS=1 才显示，正常用户看不到 -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding ThumbLoading.FpsText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding ThumbLoading.ShowFps, Converter={StaticResource BoolToVis}}" />

                <ProgressBar DockPanel.Dock="Right" Width="200" Height="14"
                             Value="{Binding ScanProgress}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center" Margin="8,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScanProgressText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <!-- ============ 浮动提示层（拖动排序等跟随鼠标提示） ============ -->
        <Canvas Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="1000">
            <Border x:Name="ReorderTip"
                    Canvas.Left="0" Canvas.Top="0"
                    Background="#E64A90D9"
                    CornerRadius="6" Padding="10,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReorderTipText" Text="↕ 拖动排序" FontSize="13" FontWeight="Bold"
                           Foreground="White" />
            </Border>
        </Canvas>
    </Grid>
</Window>
