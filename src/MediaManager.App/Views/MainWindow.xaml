<Window x:Class="MediaManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaManager.App.ViewModels"
        xmlns:core="clr-namespace:MediaManager.Core.Models;assembly=MediaManager.Core"
        xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:ctl="clr-namespace:MediaManager.App.Controls"
        mc:Ignorable="d"
        Title="媒体管理器" Height="800" Width="1400"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Closing="OnClosing"
        KeyDown="OnKeyDown"
        InputMethod.IsInputMethodEnabled="False"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.Resources>
        <!-- 缩略图「选中」描边的颜色真值在 Light.xaml / Dark.xaml（ThumbSelectionBrush）。
             这里**不再声明**它：删除模式由代码往 Window.Resources 临时塞一个琥珀色条目，
             退出时 Remove 掉，DynamicResource 就自动回到当前主题的那条蓝。
             （以前这里写死 #3B82F6，切主题也不会变，只因为蓝在深浅两套下都还能看。）
             注意：模板触发器里的 DynamicResource 是**应用那一刻**求值，不会自己跟着变；
             能换成功是因为进出删除模式都会先清空选择，环色总在「重新选中」时取到新值。 -->

        <!-- 缩略图容器。以前这里没有样式，用的是 WPF 默认高亮：选中色只从格子四周
             4px 的空隙里透出来，深色主题下几乎看不出区别 —— 「选了跟没选一样」的根因。
             现在改成把 3px 描边**画在内容之上**（不吃命中测试），右上角再挂一个勾选角标。 -->
        <Style x:Key="ThumbItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{StaticResource Space.None}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="SelRing" Margin="1" CornerRadius="8"
                                    BorderThickness="3" BorderBrush="Transparent"
                                    IsHitTestVisible="False" />
                            <!-- 角标故意从左数 28px：右上角原本是收藏星标的地盘，错开才不会打架 -->
                            <Border x:Name="SelCheck" Width="20" Height="20" CornerRadius="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,28,0" Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource ThumbSelectionBrush}">
                                <TextBlock Text="✓" Foreground="White" FontSize="{StaticResource FontSize.Body}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelRing" Property="BorderBrush"
                                        Value="{DynamicResource ThumbSelectionBrush}" />
                                <Setter TargetName="SelCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏可折叠分组标题：库 / 文件夹 / 标签 / 分类共用同一套视觉与悬停反馈 -->
        <Style x:Key="SidebarSectionHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="6,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏文字：统一继承宿主（ListBoxItem / ToggleButton）的 Foreground。
             全局隐式 TextBlock 样式会把 Foreground 写死成 TextBrush，正好盖掉
             宿主 hover/selected 时设的 PrimaryBrush —— 那才是「悬停没反应」的真正原因。
             这里在 DataTemplate / 内联内容里给个 local value，把颜色拉回宿主。 -->
        <Style x:Key="SidebarText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
        </Style>

        <!-- 折叠箭头：紧跟标题文字，不吃宿主颜色以外的任何设定 -->
        <Style x:Key="SidebarChevron" TargetType="TextBlock" BasedOn="{StaticResource SidebarText}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- 侧栏折叠：两种形态各司其职。
             展开时用 SidebarHeaderButton，成对排在左栏「▼ 库」行右端 —— 有留白、不压图，
             一眼能找到（v1.4.8 第一版把把手浮在网格边缘，贴着缩略图又压着图，
             被评价成「草台班子」；第二版把右栏那个单独挂在右栏顶部，孤零零悬在空白处，
             用户要求挪到左边来，凑成一组布局按钮）。
             收起时侧栏宽度归零，头部按钮跟着没了，只剩 SidebarCollapseHandle
             浮在窗口边缘当入口；做成有阴影的胶囊，让它看起来是「浮起来的按钮」，
             而不是一条挤在缝里的分隔线。
             ⚠ 收起态**不要用 PanelBrush 打底**：深色主题下 PanelBrush(#252526) 与网格底色
             (#1E1E1E) 几乎同色，第一版整根把手"消失"在缩略图里（截图采样确认过）。
             用比周围亮一档的 HoverBrush + ScrollThumbBrush 勾边，压在照片上也看得见。
             ⚠ 头部按钮必须带边框：不加框就是一个灰箭头浮在标题旁边，看不出能点。 -->
        <Style x:Key="SidebarHeaderButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ScrollThumbBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource FontSize.Emphasis}" TextElement.FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 收起态的浮层把手：胶囊 + 阴影，箭头用主题色常驻 —— 缩略图深浅不一，
             灰箭头压在深色照片上就看不见了。默认 0.85，指上去亮满。 -->
        <Style x:Key="SidebarCollapseHandle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{DynamicResource HoverBrush}"
                                BorderBrush="{DynamicResource ScrollThumbBrush}"
                                BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                  Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource FontSize.Title}" TextElement.FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel>
            <!-- LastChildFill=False：所有子元素都显式 Dock，最后一个（扫描）不设的话
                 会被 DockPanel 当成填充项拉满剩余宽度，变成一条横贯顶栏的巨型按钮。 -->
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchTextBox" DockPanel.Dock="Left" Width="240" Margin="0,0,10,0"
                         InputMethod.IsInputMethodEnabled="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索（Ctrl+F）" />
                <Button DockPanel.Dock="Left" Content="🔍" Margin="0,0,10,0"
                        Command="{Binding SearchCommand}" />

                <!-- 顶部类型筛选（多选：全部 / 全不选 / 选几个） -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="2,0,4,0">
                    <ToggleButton x:Name="TypeFilterToggle" Content="类型 ▾" Style="{StaticResource FilterToggleStyle}"
                                  Margin="0,0,6,0" ToolTip="按类型筛选（可多选）" />
                    <Popup x:Name="TypeFilterPopup"
                           PlacementTarget="{Binding ElementName=TypeFilterToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=TypeFilterToggle, Mode=TwoWay}">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{StaticResource Space.Xl}" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="全部" Click="OnSelectAllTypes" Margin="0,0,6,0"
                                            AutomationProperties.Name="全部" />
                                    <Button Content="全不选" Click="OnClearAllTypes"
                                            AutomationProperties.Name="全不选" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TypeFilterOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Margin="0,3"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton Content="📝 已编辑" Style="{StaticResource FilterToggleStyle}"
                                  IsChecked="{Binding EditedOnly}" Margin="0,0,6,0"
                                  ToolTip="只显示已编辑生成的副本" />
                </StackPanel>

                <!-- 主操作：新内容的唯一入口（空库欢迎页也复用它）。
                     不让「批量删除」当主按钮 —— 它是删除模式的开关、危险色由 Tag 触发，
                     做成蓝色主按钮会误导，而且 84 项实机脚本守着它的文案。 -->
                <Button DockPanel.Dock="Left" Content="＋ 添加文件夹" Margin="8,0,0,0"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        Command="{Binding AddFolderCommand}"
                        AutomationProperties.Name="添加文件夹"
                        ToolTip="把一个文件夹加入媒体库并扫描里面的媒体文件" />

                <!-- 溢出菜单：只收没有脚本锚定的低频入口（去重 / 快速查看 / 缩略图滑块）。
                     **别把批量删除、扫描、设置、插件挪进来** —— WPF Popup 是独立窗口，
                     实机脚本从主窗口 UIA 树按名字扫不到，收进来等于把回归打红。
                     Popup 里每一项都要 AutomationProperties.Name（同上，没有名字 UIA 找不着）。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <ToggleButton x:Name="OverflowToggle" Content="⋯" Width="34" Height="30" Padding="{StaticResource Space.None}"
                                  Style="{StaticResource FilterToggleStyle}"
                                  AutomationProperties.Name="更多操作"
                                  ToolTip="更多操作：去重、快速查看、缩略图大小" />
                    <!-- HorizontalOffset 把弹出层右边缘对齐到 ⋯ 按钮右边缘：
                         Placement=Bottom 默认左对齐，按钮又永远贴在窗口最右，
                         不偏移会整块跑到屏幕外被裁掉。Width 固定后 -156 是确定的。 -->
                    <Popup x:Name="OverflowPopup"
                           PlacementTarget="{Binding ElementName=OverflowToggle}"
                           Placement="Bottom" HorizontalOffset="-156"
                           StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=OverflowToggle, Mode=TwoWay}">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{StaticResource Space.Lg}" Margin="0,4,0,0" Width="190">
                            <StackPanel>
                                <Button Content="🗂 去重" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,4" Click="OnFindDuplicates"
                                        AutomationProperties.Name="去重" />
                                <Button Content="👁 快速查看" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8" Click="OnOpenFile"
                                        AutomationProperties.Name="快速查看" />
                                <TextBlock Text="缩略图大小" FontSize="{StaticResource FontSize.Meta}" Margin="4,0,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Minimum="80" Maximum="320"
                                        Value="{Binding ThumbnailSize}"
                                        AutomationProperties.Name="缩略图大小"
                                        Margin="4,0,4,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- 私密空间是独立窗口（点侧栏「🔒 私密空间」打开），主界面不承载私密视图 -->
                <Button DockPanel.Dock="Right" Content="⚙ 设置" Margin="10,0,0,0" Click="OnSettings" />
                <!-- 最常用的设置直接放主界面：一键切深浅色（其余收进设置页侧边栏分类） -->
                <!-- 用矢量图标而不是彩色 emoji：和旁边按钮的线条图标风格一致，
                     也不受 emoji 字形行框影响，18x18 的 Grid 里天然居中 -->
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Width="36" Height="30" Padding="{StaticResource Space.None}"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Click="OnThemeToggleClick" ToolTip="切换深色 / 浅色模式">
                    <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox x:Name="MoonIconHost" Stretch="Uniform">
                            <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                        <Viewbox x:Name="SunIconHost" Stretch="Uniform" Visibility="Collapsed">
                            <Path Data="M12 6.5A5.5 5.5 0 1 0 12 17.5 5.5 5.5 0 1 0 12 6.5Z M12 1.5V4.5 M12 19.5V22.5 M1.5 12H4.5 M19.5 12H22.5 M4.6 4.6L6.7 6.7 M17.3 17.3L19.4 19.4 M4.6 19.4L6.7 17.3 M17.3 6.7L19.4 4.6"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                    </Grid>
                </Button>
                <!-- 插件入口：默认隐藏，只有真的加载到插件才出现（没插件时不占地方、不误导） -->
                <Button x:Name="PluginButton" DockPanel.Dock="Right" Content="🧩 插件" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="OnPluginMenuClick"
                        ToolTip="由插件提供的扩展功能" />
                <Button DockPanel.Dock="Right" Content="🔄 刷新" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <!-- 批量删除：只做「进入 / 退出删除模式」这一件事，永远可点，绝不置灰。
                     曾经它还兼管「已选中 N 项 → 直接删掉」，结果是用户一选中图片，这个按钮
                     就变成蓝底「删除选中的 2 项」，看起来像删除模式已经被启动了 —— 实际只是
                     换了个文案。一个按钮背三种语义，怎么解释都绕，所以拆开：
                       · 顶部这个   = 开 / 关删除模式（开着时红底「退出删除模式」）
                       · 底部悬浮条 = 删除当前选中的 N 项（这里才有数字，才叫「确认删除」）
                     状态由代码写进 Tag，样式触发器按 Tag 换色（DynamicResource，切主题不脱色）。
                     图标用矢量 Path 而不是 🗑 emoji：U+1F5D1 在不少 Windows 字体里没有字形，
                     实测会渲染成一个空心方框。Content 是自绘面板时 UIA 读不到文字，
                     AutomationProperties.Name 必须动态维护。 -->
                <Button x:Name="BatchDeleteButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Tag="idle" Click="OnBatchDelete"
                        AutomationProperties.Name="批量删除"
                        ToolTip="进入删除模式：之后单击文件即可打勾 / 删除。再点一下退出。">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform">
                            <Path Data="M3 6 H21 M8 6 V4 H16 V6 M5 6 L6 21 H18 L19 6 M10 10 V17 M14 10 V17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Viewbox>
                        <TextBlock x:Name="BatchDeleteCaption" Text="批量删除" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="mode">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="扫描" Margin="0,0,8,0"
                        Command="{Binding ScanAllCommand}" />
            </DockPanel>

            <!-- 删除模式横幅：在工具栏里**单独占一行**，不是浮在网格上。
                 浮在 Grid.Row=1 顶部会盖住第一排缩略图，用户看不见自己要点什么；
                 Collapsed 时这一行不占位，主界面和原来一模一样，展开时网格自动让位。 -->
            <Border x:Name="TapDeleteBar" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Padding="12,7" CornerRadius="9" MaxWidth="820"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 文案由 DeletePolicy.DeleteModeHint 在代码里填：
                         写死「进回收站，5 秒内可撤销」会在设置改成永久删除后变成假话。
                         这里留个中性占位，免得设计器里空着。 -->
                    <TextBlock x:Name="TapDeleteHint"
                               Text="删除模式"
                               FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="2,0,14,0" />
                    <!-- 默认勾选：进删除模式后单击只打勾，不会「点啥删啥」。
                         想去掉这层保险（真·点谁删谁）就当场取消勾选，默认值每次进入都复位。 -->
                    <CheckBox x:Name="TapDeleteMarkOnly" Content="先勾选，再统一删除"
                              IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="OnTapDeleteOptionChanged" Unchecked="OnTapDeleteOptionChanged"
                              ToolTip="默认勾选：单击文件只打勾不删除，选好再点「删除选中的 N 项」确认。想去掉这层保险就取消勾选，变成点谁删谁" />
                    <TextBlock x:Name="TapDeleteCount" Text="" FontSize="{StaticResource FontSize.Body}" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="退出模式 (Esc)" Click="OnExitTapDelete" Padding="10,3"
                            ToolTip="关掉删除模式，单击文件恢复成正常的选中 / 双击预览" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Border>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1">
            <!-- 左右两列可收起，宽度由 ApplySidebarState() 控制（收起时归零，
                 留窄边会把缩略图挤成少一列，实测过） -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightSidebarColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧导航 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Space.Md}">
                        <!-- 「▼ 库」这一行的右端就是折叠按钮的家：有 8px 留白，
                             不在缩略图上，也不紧贴任何东西 -->
                        <DockPanel Margin="8,8,4,4" LastChildFill="False">
                            <Button x:Name="LeftHeaderCollapse" DockPanel.Dock="Right"
                                    Style="{StaticResource SidebarHeaderButton}"
                                    VerticalAlignment="Center"
                                    Content="«"
                                    AutomationProperties.AutomationId="LeftSidebarToggle"
                                    ToolTip="收起左侧栏，把空间让给缩略图"
                                    Click="OnToggleLeftSidebar" />
                            <ToggleButton x:Name="NavToggle" IsChecked="True"
                                          Click="OnToggleSection" Tag="Nav"
                                          Style="{StaticResource SidebarSectionHeader}"
                                          HorizontalAlignment="Left"
                                          ToolTip="展开 / 收起库视图">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NavChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                    <TextBlock Text=" 库" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                                </StackPanel>
                            </ToggleButton>
                        </DockPanel>
                        <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}">
                            <ListBoxItem Tag="discovery" PreviewMouseLeftButtonDown="OnNavClick" IsSelected="True">
                                <TextBlock Text="✨ 发现" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="all" PreviewMouseLeftButtonDown="OnNavClick">
                                <TextBlock Text="🏠 全部媒体" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="favorites" PreviewMouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐ 收藏" Style="{StaticResource SidebarText}" />
                                    <TextBlock Text="{Binding DataContext.FavoriteCount, StringFormat=( {0} ), RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource SidebarText}" Opacity="0.65" FontSize="{StaticResource FontSize.Small}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="unfiled" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📥 未分类" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="recent-view" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🕒 最近查看" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="recent" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🕘 最近添加" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="diary" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📔 日记" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <ListBoxItem Tag="trash" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🗑 最近删除" Style="{StaticResource SidebarText}" />
                            </ListBoxItem>
                            <!-- 私密空间：默认点一下直接进（没设密码时就是一层隐藏）；设过密码则先弹解锁窗 -->
                            <ListBoxItem x:Name="VaultNavItem" Tag="vault" PreviewMouseLeftButtonDown="OnNavClick"
                                         Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 私密空间" Style="{StaticResource SidebarText}" />
                                    <TextBlock Text="{Binding PrivateCount, StringFormat=( {0} )}"
                                               Opacity="0.65" FontSize="{StaticResource FontSize.Small}"
                                               VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SidebarText}">
                                                <Style.Triggers>
                                                    <!-- 空保险箱不显示 ( 0 )，免得像「坏了」 -->
                                                    <DataTrigger Binding="{Binding PrivateCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- 分类：v1.3.2 起是唯一的归类维度（收藏夹已并入），也是拖拽归类的落点 -->
                        <!-- 极简模式整组隐藏：分类对轻度用户是「多出来的一套概念」，藏掉不影响文件 -->
                        <!-- 位置在「文件夹」之前：分类是用户自己划的「分区」，比系统路径更常点 -->
                        <ToggleButton x:Name="CategoryToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Category"
                                      Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起分类分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 分类" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                                <TextBlock Text="{Binding CategoryCount, StringFormat=( {0} )}" FontSize="{StaticResource FontSize.Small}"
                                           Style="{StaticResource SidebarText}" Opacity="0.65"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="CategoryAddPanel" Orientation="Horizontal" Margin="8,0,8,4"
                                    Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                            <Button Content="＋ 新建分类" Command="{Binding AddCategoryCommand}" />
                        </StackPanel>
                        <ListBox x:Name="CategoryListBox" BorderThickness="0" Background="Transparent"
                                 Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                 ItemsSource="{Binding CategoryItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnCategorySelectionChanged"
                                 PreviewMouseLeftButtonDown="OnReorderMouseDown"
                                 PreviewMouseMove="OnReorderMouseMove"
                                 PreviewMouseLeftButtonUp="OnReorderMouseUp"
                                 AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop"
                                 Tag="Category">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SidebarText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名" Click="OnRenameCategoryMenu" />
                                    <Separator />
                                    <MenuItem Header="删除" Click="OnDeleteCategoryMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <ToggleButton x:Name="FolderToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Folder"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      ToolTip="展开 / 收起文件夹分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FolderChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 文件夹" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                            </StackPanel>
                        </ToggleButton>
                        <ListBox x:Name="FolderListBox" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding FolderItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnFolderSelectionChanged">
                            <ListBox.ItemTemplate>
                                <!-- 两级显示：末级目录名 + 盘符/上级目录小字。
                                     以前直接放整条路径，侧栏宽度不够被截成
                                     「C:\Users\xxx\Videos\Capt…」，两个目录看着一模一样 -->
                                <DataTemplate>
                                    <!-- 用 Grid 而不是横向 StackPanel：横向 StackPanel 会给子项无限宽度，
                                         TextTrimming 失效 → 长路径文字直接溢出侧栏（实测踩过） -->
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 展开三角：只有真有子文件夹的节点才显示。
                                             用 Hidden 而不是 Collapsed —— Collapsed 会把这一列
                                             收成 0 宽，没有子目录的根目录标题就会比有子目录的
                                             左移 16px，看着像缩进错乱 -->
                                        <Button x:Name="Expander" Grid.Column="0" Content="▸" Width="16" Height="16"
                                                Padding="{StaticResource Space.None}" Margin="0,0,3,0" FontSize="{StaticResource FontSize.Caption}" Opacity="0.75"
                                                Background="Transparent" BorderThickness="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleFolderNodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="Hidden"
                                                ToolTip="展开 / 收起子文件夹" />
                                        <StackPanel x:Name="Root" Grid.Column="1" ToolTip="{Binding ToolTipText}">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource SidebarText}" />
                                            <TextBlock Text="{Binding SubTitle}" TextTrimming="CharacterEllipsis"
                                                       FontSize="{StaticResource FontSize.Caption}" Opacity="0.55" Margin="0,1,0,0"
                                                       Style="{StaticResource SidebarText}" />
                                            <!-- 离线标记：移动硬盘没插 / 盘符变了时提前告知，
                                                 别让用户点进去看到「共 0 项」还以为是软件坏了 -->
                                            <TextBlock x:Name="OfflineBadge" Text="⛔ 离线" FontSize="{StaticResource FontSize.Caption}"
                                                       Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"
                                                       Margin="0,2,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="Expander" Property="Content" Value="▾" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                            <Setter TargetName="TitleText" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="OfflineBadge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Root" Property="ToolTip"
                                                    Value="文件夹当前不可达（移动硬盘未连接或路径已变更）。重新连接后点「扫描」即可恢复。" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开所在位置" Click="OnOpenFolderMenu" />
                                    <Separator />
                                    <MenuItem Header="从库中移除" Click="OnRemoveFolderMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- 标签和「分类」一样属于整理概念：极简模式一并收起，
                             否则「极简」里还留着一个新建标签按钮，跟分类被藏掉自相矛盾 -->
                        <ToggleButton x:Name="TagToggle" IsChecked="True" Margin="8,16,8,4"
                                      Click="OnToggleSection" Tag="Tag"
                                      Style="{StaticResource SidebarSectionHeader}"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                      ToolTip="展开 / 收起标签分组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TagChevron" Text="▼" Style="{StaticResource SidebarChevron}" />
                                <TextBlock Text=" 标签" FontWeight="Bold" Style="{StaticResource SidebarText}" />
                                <TextBlock Text="{Binding TagCount, StringFormat=( {0} )}" FontSize="{StaticResource FontSize.Small}"
                                           Style="{StaticResource SidebarText}" Opacity="0.65"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="TagAddPanel" Orientation="Horizontal" Margin="8,0,8,4"
                                    Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}">
                            <Button Content="＋ 新建标签" Command="{Binding AddTagCommand}" />
                        </StackPanel>
                        <ListBox x:Name="TagListBox" BorderThickness="0" Background="Transparent"
                                 Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBoolToVis}}"
                                 ItemsSource="{Binding TagItems}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 SelectionChanged="OnTagSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnReorderMouseDown"
                                 PreviewMouseMove="OnReorderMouseMove"
                                 PreviewMouseLeftButtonUp="OnReorderMouseUp"
                                 AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop"
                                 Tag="Tag">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SidebarText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名" Click="OnRenameTagMenu" />
                                    <Separator />
                                    <MenuItem Header="删除" Click="OnDeleteTagMenu" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 中间缩略图网格 ===== -->
            <!-- ZIndex 必须压过左右两栏：把手靠负 margin 退回到侧栏内侧，
                 如果这一层在下面，落在侧栏上的那半个把手就点不到了（实测右侧点不动）。 -->
            <Grid Grid.Column="1" Panel.ZIndex="10" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 内容区抬头（唯一一条） =====
                     以前这里叠了两个 Border 都在 Grid.Row=0：发现页工具栏 + 排序条，
                     靠 IsDiscoveryView 正反向可见性互斥。改成一条之后左右分栏：
                       左 = 视图标题 · 结果数 + 面包屑（长路径截断，ToolTip 保留全路径）
                       右 = 发现页时是「推荐池 / 换一批」，其余视图是排序组
                     右边两组仍然互斥（同一位置），不会露出两条，也不会把「换一批」弄丢。 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- MinWidth：1020 最小宽度 + 双栏展开时，右侧两组能吃掉整行，
                                 没有下限的话标题/结果数会被压成 0 宽直接消失（实测）。 -->
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 结果数来自 _totalCount（只读），不解析状态栏文案：
                             状态栏还承载离线 / 分页这些诊断句子，解析字符串迟早错位。 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ViewTitle}" FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" · " FontSize="{StaticResource FontSize.Body}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ResultCountText}" FontSize="{StaticResource FontSize.Body}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding BreadcrumbText}"
                                       ToolTip="{Binding BreadcrumbTooltip}"
                                       FontSize="{StaticResource FontSize.Meta}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasBreadcrumb, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- 发现页：推荐池 + 换一批 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsDiscoveryView, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="推荐池：" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <!-- 两个下拉的选项都很短（收藏/全部/未分类/指定分类、分类名），
                                     160 宽在 1020 + 双栏下会把标题挤没，收到刚好放得下的宽度。 -->
                                <ComboBox Width="96"
                                          ItemsSource="{Binding DiscoveryPoolOptions}"
                                          SelectedIndex="{Binding DiscoveryPoolIndex}" />
                                <ComboBox x:Name="DiscoveryPoolCombo" Width="112" Margin="10,0,0,0"
                                          ItemsSource="{Binding DiscoveryPoolCategories}"
                                          DisplayMemberPath="Name"
                                          Visibility="{Binding DiscoveryPoolIndex, Converter={StaticResource DiscoveryPoolVis}}"
                                          SelectionChanged="OnDiscoveryCategoryChanged" />
                                <Button Content="🎲 换一批 (R)" Margin="10,0,0,0"
                                        Command="{Binding RefreshDiscoveryCommand}" />
                            </StackPanel>

                            <!-- 普通视图：排序。最近查看是内存 Top100 —— 控件仍显示但被禁用 +
                                 ToolTip 说明原因，避免「控件亮着、点了不生效」。 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsDiscoveryView, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="排序：" VerticalAlignment="Center"
                                           Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <!-- 必须用 ItemTemplate 而不是 DisplayMemberPath：
                                     全局 ComboBox 模板显示的是 SelectionBoxItem，
                                     DisplayMemberPath 在这套自定义模板里不生效，选中后会显示
                                     record 的 ToString（"SortOption (File...)"）。 -->
                                <ComboBox Width="132"
                                          ItemsSource="{Binding SortOptions}"
                                          SelectedValuePath="Field"
                                          SelectedValue="{Binding SortField, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSortEnabled}"
                                          ToolTip="{Binding SortDisabledReason}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Margin="8,0,0,0" Padding="10,2"
                                        Content="{Binding SortDirectionText}"
                                        Command="{Binding ToggleSortDirectionCommand}"
                                        IsEnabled="{Binding IsSortEnabled}"
                                        ToolTip="{Binding SortDisabledReason}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 中央空状态（空 / 出错 / 离线）=====
                     文案和状态栏共用一句（VM 的 CenterEmptyText 直接取 ExplainEmptyResultAsync
                     拼好的诊断），所以「磁盘未连接」这类说法只有一处来源。 -->
                <Border Grid.Row="1" Panel.ZIndex="18"
                        Background="{DynamicResource BgBrush}"
                        Visibility="{Binding IsCenterEmptyVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="560" Margin="{StaticResource Space.Xxl}">
                        <TextBlock Text="{Binding CenterEmptyTitle}" FontSize="{StaticResource FontSize.PageTitle}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding CenterEmptyText}" FontSize="{StaticResource FontSize.BodyLarge}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}"
                                Margin="0,16,0,0" Padding="16,5" HorizontalAlignment="Center"
                                AutomationProperties.Name="刷新" />
                    </StackPanel>
                </Border>

                <!-- 首屏加载遮罩：只在列表还空着时盖，已有内容刷新时不闪 -->
                <Border Grid.Row="1" Panel.ZIndex="19"
                        Background="{DynamicResource BgBrush}"
                        Visibility="{Binding IsCenterLoadingVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="6" />
                        <TextBlock Text="正在加载…" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 发现页：空库欢迎引导 -->
                <Border Grid.Row="1" Background="{DynamicResource BgBrush}"
                        Panel.ZIndex="10"
                        Visibility="{Binding DiscoveryShowWelcome, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="👋 欢迎使用媒体管理器" FontSize="{StaticResource FontSize.Hero}" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="先添加一个媒体文件夹，开始整理你的图片和视频"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <Button Content="＋ 添加文件夹" HorizontalAlignment="Center" Padding="20,8"
                                FontSize="{StaticResource FontSize.Emphasis}" Command="{Binding AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <!-- 发现页：首次提示 -->
                <!-- Panel.ZIndex 必须比 ListBox 高：这个气泡在 XAML 里声明在网格**之前**，
                     不给 ZIndex 就会被缩略图整片盖住，只在格子缝隙里露出一行字（v1.4.5 修）。 -->
                <Border Grid.Row="1" Background="Transparent"
                        Panel.ZIndex="20"
                        Visibility="{Binding DiscoveryShowHint, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        IsHitTestVisible="False">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="{DynamicResource PanelBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,10">
                        <TextBlock Text="{Binding DiscoveryHintText}"
                                   FontSize="{StaticResource FontSize.Emphasis}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Border>

                <ListBox x:Name="ThumbList"
                         Grid.Row="1"
                         ItemsSource="{Binding MediaItems}"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource ThumbItemStyle}"
                         MouseDoubleClick="OnItemDoubleClick"
                         PreviewMouseLeftButtonDown="OnThumbListMouseDown"
                         PreviewMouseMove="OnThumbListMouseMove"
                         PreviewMouseLeftButtonUp="OnThumbListMouseUp"
                         LostMouseCapture="OnThumbLostCapture"
                         PreviewMouseWheel="OnThumbListPreviewMouseWheel"
                         SelectionChanged="OnThumbListSelectionChanged"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="OnContextMenuOpened">
                            <MenuItem Header="⭐ 收藏/取消收藏 (F)" Click="OnFavoriteMenu" />
                            <Separator />
                            <MenuItem x:Name="CategoryMenu" Header="📁 分类" />
                            <Separator />
                            <MenuItem Header="📂 用系统默认程序打开 (Ctrl+O)" Click="OnOpenExternallyMenu" />
                            <MenuItem Header="📂 打开所在位置 (Ctrl+Enter)" Click="OnOpenLocationMenu" />
                            <MenuItem Header="重命名 (F2)" Click="OnRenameMenu" />
                            <MenuItem x:Name="BatchRenameMenu" Header="✏ 批量重命名…" Click="OnBatchRenameMenu" />
                            <MenuItem x:Name="BatchExportMenu" Header="📤 批量导出 / 统一尺寸…" Click="OnBatchExportMenu" />
                            <!-- 标题由 DeletePolicy.ContextDeleteHeader 在 OnContextMenuOpened 里填，
                                 不写死「删除到回收站」：设置改成永久删除后那就是假话。 -->
                            <MenuItem x:Name="DeleteMenu" Header="删除 (Delete)" Click="OnDeleteMenu" />
                            <Separator />
                            <MenuItem x:Name="MoveIntoVaultMenu" Header="🔒 移入私密空间" Click="OnMoveIntoVaultMenu" />
                            <MenuItem x:Name="AddToDiaryMenu" Header="📔 写进日记" Click="OnAddToDiaryMenu" />
                            <Separator />
                            <MenuItem Header="打星">
                                <MenuItem Header="⭐ 1" Click="OnRateMenu" Tag="1" />
                                <MenuItem Header="⭐⭐ 2" Click="OnRateMenu" Tag="2" />
                                <MenuItem Header="⭐⭐⭐ 3" Click="OnRateMenu" Tag="3" />
                                <MenuItem Header="⭐⭐⭐⭐ 4" Click="OnRateMenu" Tag="4" />
                                <MenuItem Header="⭐⭐⭐⭐⭐ 5" Click="OnRateMenu" Tag="5" />
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vw:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MinWidth="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MinHeight="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MaxWidth="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  MaxHeight="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Margin="{StaticResource Space.Sm}">
                                <Grid.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ResolutionDisplay}" Foreground="#BBBBBB" FontSize="{StaticResource FontSize.Small}" />
                                            <TextBlock Text="{Binding SizeDisplay}" Foreground="#BBBBBB" FontSize="{StaticResource FontSize.Small}" />
                                            <TextBlock Text="{Binding Note, StringFormat=备注：{0}}"
                                                       TextWrapping="Wrap" MaxWidth="260" FontSize="{StaticResource FontSize.Small}"
                                                       Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                    </ToolTip>
                                </Grid.ToolTip>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid ClipToBounds="True">
                                        <!-- 骨架屏：缩略图未就绪时的柔和底色 + 极简照片占位标识。
                                             刻意放在 Image **下面**（不是上面）：图片加载完会把它完全盖住，
                                             这样就不需要任何逐项的 Visibility 绑定，也就没有逐项布局重算。
                                             纯静态图形、零动画 —— 虚拟化列表里才不会掉帧。 -->
                                        <Border Background="{DynamicResource SkeletonBrush}"
                                                Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}">
                                            <Grid Width="32" Height="26" Opacity="0.2"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="1.2" CornerRadius="3" />
                                                <Ellipse Width="4.2" Height="4.2"
                                                         Fill="{DynamicResource TextSecondaryBrush}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Margin="5,4,0,0" />
                                                <Path Data="M0,10 L6,2 L10.5,6.5 L13.5,3.5 L20,10 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Stretch="Fill" Margin="6,11,6,4" />
                                            </Grid>
                                        </Border>
                                        <Image ctl:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}"
                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                        <Border Background="#22000000"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="▶" Foreground="White" FontSize="{StaticResource FontSize.Hero}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                        <!-- 非视觉类型（文档/压缩包/音频）：彩色矢量类型图标。
                                             以前这里是 emoji（📄 🗜️ 🎵），而 emoji 在 WPF 里能不能出彩色
                                             完全看系统字体：很多机器回落到 Segoe UI Symbol 的单色字形，
                                             看着就像「图标没加载出来」。现在改成纯矢量绘制，任何机器一致。
                                             宽高跟着格子大小走（96:118 的稿，×0.46 / ×0.565 保持比例），
                                             拖缩略图滑块时不会变形。 -->
                                        <ctl:FileTypeIconView Icon="{Binding FileIcon}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.46}"
                                                              Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.565}"
                                                              Visibility="{Binding IsNonVisual, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="{Binding FileIcon.Description}" />
                                        <Border Background="#E6C627" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" CornerRadius="0,0,0,8"
                                                Padding="5,1"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="★" FontSize="{StaticResource FontSize.Subtitle}" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                        <Border Background="#2E7DD1" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" CornerRadius="0,0,8,0"
                                                Padding="5,1"
                                                ToolTip="{Binding CategoryNames, StringFormat=分类：{0}}"
                                                Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="📁" FontSize="{StaticResource FontSize.Body}" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- 文件名压在图上的底部渐变遮罩：白字压浅色图片也能看清（浅色主题下尤其明显）。
                                     ⚠ 两个约束，缺一个就是坑：
                                     1) IsHitTestVisible=False —— Border 一旦有渐变背景就参与命中测试，
                                        整块格子（含下面那条悬停按钮）的点击会被这层吸走，按钮看着在、点不动。
                                     2) 必须排在快捷条**前面**（Z 序更靠下）—— 否则底部 65% 的黑
                                        会把 ⭐ 按钮一起压暗。
                                     以前这两条都没有：遮罩声明在快捷条之后、也没关命中测试。 -->
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.6" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#A6000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontSize.Small}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Margin="{StaticResource Space.Sm}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <!-- 悬停快捷操作条。
                                     这里原来有三个按钮，其中 🏷（加标签）和 📁（加分类）**没有 Command**，
                                     ToolTip 还写着「（右键菜单）」—— 点了完全没反应，纯摆设。
                                     标签/分类本来就只能通过右键菜单操作，与其摆两个假按钮骗人，
                                     不如只留真实可用的 ⭐。要加标签就右键。 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Margin="0,0,4,4" Opacity="0">
                                    <Button Width="24" Height="24" Padding="{StaticResource Space.None}" Margin="{StaticResource Space.Xs}"
                                            ToolTip="收藏 / 取消收藏"
                                            AutomationProperties.Name="收藏 / 取消收藏"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource Icon.Star}" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource FavoriteBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                                    </Button>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 分页：加载更多（方案 A）。只在还有未加载项时显示 -->
                <Button Grid.Row="1"
                        Content="{Binding LoadMoreText}"
                        Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,20" Padding="18,8" FontSize="{StaticResource FontSize.Subtitle}"
                        Panel.ZIndex="20" Opacity="0.95"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}"
                        ToolTip="加载下一页（每页 2000 项）" />

                <!-- 框选矩形层 -->
                <Border x:Name="SelectionRect"
                        Grid.Row="1"
                        BorderBrush="#4A90D9" BorderThickness="1"
                        Background="#334A90D9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />

                <!-- 侧栏收起后，头部那个按钮跟着侧栏一起没了，这里是唯一入口。
                     平时隐藏（展开时用侧栏头部的按钮），只有对应侧栏收起来才显示；
                     贴窗口边缘、垂直居中，右侧让 20px 避开网格滚动条。见 ApplySidebarState()。 -->
                <Button x:Name="LeftCollapseHandle" Grid.RowSpan="2"
                        Style="{StaticResource SidebarCollapseHandle}"
                        HorizontalAlignment="Left" Margin="5,0,0,0"
                        Panel.ZIndex="30" Visibility="Collapsed"
                        Content="›"
                        AutomationProperties.AutomationId="LeftSidebarToggle"
                        ToolTip="展开左侧栏"
                        Click="OnToggleLeftSidebar" />

                <Button x:Name="RightCollapseHandle" Grid.RowSpan="2"
                        Style="{StaticResource SidebarCollapseHandle}"
                        HorizontalAlignment="Right" Margin="0,0,20,0"
                        Panel.ZIndex="30" Visibility="Collapsed"
                        Content="‹"
                        AutomationProperties.AutomationId="RightSidebarToggle"
                        ToolTip="展开右侧详情栏"
                        Click="OnToggleRightSidebar" />
            </Grid>

            <!-- ===== 右侧详情面板 ===== -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- 折叠按钮贴右栏自己的左端（文件名左侧），和左栏右上角那个成对：
                             两个都靠中间网格、各在自己栏里，留 8px 间距不贴着文字 -->
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <Button x:Name="RightHeaderCollapse" DockPanel.Dock="Left"
                                    Style="{StaticResource SidebarHeaderButton}"
                                    VerticalAlignment="Top" Margin="0,0,8,0"
                                    Content="»"
                                    AutomationProperties.AutomationId="RightSidebarToggle"
                                    ToolTip="收起右侧详情栏，把空间让给缩略图"
                                    Click="OnToggleRightSidebar" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding DetailName}" FontWeight="Bold" FontSize="{StaticResource FontSize.Title}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Visibility="{Binding IsDetailSingle, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding SelectionSummaryText}" FontWeight="Bold" FontSize="{StaticResource FontSize.Title}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsDetailMultiple, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="未选择文件" FontWeight="Bold" FontSize="{StaticResource FontSize.Title}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding IsDetailEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DockPanel>

                        <!-- 空选态 -->
                        <StackPanel Visibility="{Binding IsDetailEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="点一张缩略图看详情；按住 Ctrl / Shift 可以多选。"
                                       TextWrapping="Wrap" FontSize="{StaticResource FontSize.BodyLarge}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- 多选态：操作复用底部 SelectionBar（同一套入口），这里只给摘要和指路 -->
                        <StackPanel Visibility="{Binding IsDetailMultiple, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectionPreviewText}" TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSize.BodyLarge}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="批量删除 / 批量分类 / 收藏都在窗口底部那条操作条里；Esc 也能退出选择。"
                                       TextWrapping="Wrap" FontSize="{StaticResource FontSize.BodyLarge}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="取消选择" Click="OnClearSelection"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- 单选态：备注 / 分类 / EXIF 只对单选有意义 -->
                        <StackPanel Visibility="{Binding IsDetailSingle, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DetailDate}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                        <Separator Margin="0,12" />

                        <Button Content="⭐ 收藏" HorizontalAlignment="Stretch"
                                Command="{Binding ToggleFavoriteCommand}"
                                CommandParameter="{Binding SelectedItem}" />

                        <Separator Margin="0,12" />

                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="所属分类" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="＋ 加入" MinWidth="58" Padding="8,1"
                                    FontSize="{StaticResource FontSize.Meta}"
                                    ToolTip="把当前文件加入一个或多个分类（可连续勾选）"
                                    Click="OnDetailAddCategoryClick" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SelectedCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button Width="20" Height="20" Padding="{StaticResource Space.None}" DockPanel.Dock="Right"
                                                ToolTip="移出该分类"
                                                AutomationProperties.Name="移出该分类"
                                                Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource Icon.Close}" Width="7" Height="7" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                        </Button>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 一个都没加时给个提示，避免「空一块」看着像坏了 -->
                        <TextBlock Text="还没有归入任何分类" FontSize="{StaticResource FontSize.Meta}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- 没选中任何文件时别显示这句：面板本身是常驻的，
                                             空选状态下说「还没有归入任何分类」会让人以为是个坏掉的文件 -->
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Separator Margin="0,12" />

                        <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBox x:Name="NoteBox"
                                 InputMethod.IsInputMethodEnabled="True"
                                 Text="{Binding NoteEditor, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="40" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewMouseWheel="OnNoteBoxPreviewMouseWheel" />
                        <Button Content="💾 保存备注" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Command="{Binding SaveNoteCommand}" />

                        <Separator Margin="0,12" />

                        <TextBlock Text="EXIF 信息" FontWeight="Bold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ExifItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 之前只绑了 Key（而且 Key 存的是值），面板上只剩「1080:」这种行。
                                         现在键值都显示：键半粗、值常规，长值自动换行。
                                         Run.Text 默认是 TwoWay，只读集合必须写 Mode=OneWay。 -->
                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSize.Body}"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="：" />
                                        <Run Text="{Binding Value, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 多选操作条（网格底部悬浮，像手机相册；没选中时整条不占位） ============
             ZIndex 低于撤销提示条 / 轻提示：删除完成后选中被清空、这条自动收起，提示条会盖上来，
             两者不会叠成两层。底部留 18px，和上方 74px 的轻提示错开。 -->
        <Border x:Name="SelectionBar" Grid.Row="1" Panel.ZIndex="895"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="14,10" CornerRadius="10"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCountText" Text="已选中 0 项"
                           FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="4,0,16,0" />
                <Button Content="取消选择" Click="OnClearSelection" Margin="0,0,8,0"
                        ToolTip="清空当前选择（Esc 之外最直观的退出方式）" />
                <Button Content="📁 批量分类" Click="OnBatchCategory" Margin="0,0,8,0"
                        ToolTip="把选中的文件一次加入某个分类" />
                <!-- 删除按钮和顶部同款矢量图标；文字 / UIA 名称由 UpdateSelectionUi 同步 -->
                <Button x:Name="SelectionBarDeleteButton" Click="OnDeleteSelected" MinWidth="160"
                        FontWeight="SemiBold" AutomationProperties.Name="删除选中的 0 项"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        ToolTip="删除当前选中的文件">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform">
                            <Path Data="M3 6 H21 M8 6 V4 H16 V6 M5 6 L6 21 H18 L19 6 M10 10 V17 M14 10 V17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Viewbox>
                        <TextBlock x:Name="SelectionBarDeleteCaption" Text="删除选中的 0 项"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ 删除撤销提示条（底部居中，5 秒后自动消失） ============ -->
        <!-- 发现新文件提示（右下角） -->
        <Border Grid.Row="1" Panel.ZIndex="901"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,60" Padding="14,11" CornerRadius="8" MaxWidth="380"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                Visibility="{Binding IsNewFilesToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" FontSize="{StaticResource FontSize.Section}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NewFilesToastText}" VerticalAlignment="Center"
                               Margin="8,0,8,0" FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding NewFilesSecondsLeft, Mode=OneWay}" /><Run Text=" 秒后自动加入" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                    <Button Content="加入库" Command="{Binding JoinNewFilesCommand}" MinWidth="72"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White"
                            BorderBrush="{DynamicResource PrimaryBrush}" />
                    <Button Content="忽略" Command="{Binding IgnoreNewFilesCommand}" MinWidth="60"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作轻提示（1.8 秒自动消失）：只用来说结果，不带按钮 -->
        <Border Grid.Row="1" Panel.ZIndex="899"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,74" Padding="12,7" CornerRadius="14"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{Binding IsActionToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ActionToastText}" FontSize="{StaticResource FontSize.BodyLarge}" />
        </Border>

        <Border Grid.Row="1" Panel.ZIndex="900"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="14,9" CornerRadius="8"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding IsUndoToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗑" FontSize="{StaticResource FontSize.Section}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UndoToastText}" VerticalAlignment="Center"
                           Margin="8,0,10,0" FontSize="{StaticResource FontSize.Subtitle}" />
                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding UndoSecondsLeft, Mode=OneWay}" /><Run Text=" 秒" />
                </TextBlock>
                <Button Content="撤销" Command="{Binding UndoDeleteCommand}"
                        Margin="14,0,0,0" MinWidth="64"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" />

                <!-- 帮助入口常驻状态栏：小白不用先猜「设置里哪一页」才知道怎么多选、怎么删 -->
                <Button DockPanel.Dock="Right" Content="❓ 帮助与快捷键" Click="OnOpenHelp"
                        Padding="8,2" Margin="0,0,4,0" FontSize="{StaticResource FontSize.Meta}"
                        ToolTip="打开快速上手指南与快捷键列表（设置 → 帮助与快捷键）" />

                <!-- 缩略图加载指示：队列清空后自动隐藏。
                     数据来自 ThumbnailLoadMonitor 的 250ms 聚合，不订阅逐图事件（否则 UI 线程会被回调淹没）。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="{Binding ThumbLoading.IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="68" Height="6" Maximum="100" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Value="{Binding ThumbLoading.Progress, Mode=OneWay}" />
                    <TextBlock Text="{Binding ThumbLoading.StatusText}" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Body}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 调试帧率：启动前设环境变量 MM_FPS=1 才显示，正常用户看不到 -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding ThumbLoading.FpsText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontSize="{StaticResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding ThumbLoading.ShowFps, Converter={StaticResource BoolToVis}}" />

                <ProgressBar DockPanel.Dock="Right" Width="200" Height="14"
                             Value="{Binding ScanProgress}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center" Margin="8,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScanProgressText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <!-- ============ 浮动提示层（拖动排序等跟随鼠标提示） ============ -->
        <Canvas Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="1000">
            <Border x:Name="ReorderTip"
                    Canvas.Left="0" Canvas.Top="0"
                    Background="#E64A90D9"
                    CornerRadius="6" Padding="10,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReorderTipText" Text="↕ 拖动排序" FontSize="{StaticResource FontSize.Subtitle}" FontWeight="Bold"
                           Foreground="White" />
            </Border>
        </Canvas>
    </Grid>
</Window>
