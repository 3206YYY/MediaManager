<Window x:Class="MediaManager.App.Views.RecentlyDeletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MediaManager.App.Controls"
        Title="最近删除" Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 & 说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="最近删除" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="这些文件已经被移到 Windows 回收站，可以随时还原回原来的位置。列表保留 30 天。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <ListView x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="46" Height="46" CornerRadius="4" ClipToBounds="True"
                                        Background="{DynamicResource SidebarBrush}">
                                    <Image ctl:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DirectoryDisplay}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding DeletedAtDisplay, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="↩ 还原" Click="OnRestoreClick" Tag="{Binding}"
                                            MinWidth="76" Margin="0,0,8,0" />
                                    <Button Content="彻底删除" Click="OnPurgeClick" Tag="{Binding}"
                                            MinWidth="82" Background="#C0392B" Foreground="White"
                                            BorderBrush="#C0392B" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="🗑" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="这里还没有删除记录" FontSize="14" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="删除文件后，可以在这里查看并还原" FontSize="12" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部操作 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="清空列表记录" Click="OnClearRecords" />
            <Button DockPanel.Dock="Right" Content="关闭" Width="100" Click="OnClose" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
