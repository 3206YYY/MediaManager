<Window x:Class="MediaManager.App.Views.ArchiveInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="压缩包" Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoText" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />

        <ListView x:Name="EntryList" Grid.Row="1" Margin="0,8,0,8"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource TextBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="540" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding SizeDisplay}" />
                    <GridViewColumn Header="压缩后" Width="120" DisplayMemberBinding="{Binding CompressedDisplay}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="用系统程序打开" Click="OnOpenWithSystem" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
        </StackPanel>
    </Grid>
</Window>
