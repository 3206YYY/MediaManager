<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        系统控件重绘：DatePicker / Calendar
        =====================================================================
        为什么必须整个换模板：
        WPF 自带 CalendarItem 的 Aero2 模板里 **背景是硬编码 #FFFFFFFF**，
        日期格按钮也各有一份写死浅色的模板。只改 Background/Foreground 完全没用
        —— 深色主题下弹出来的就是一块白板，浅灰数字印在上面几乎看不见。

        为什么全部写成「带 key 的样式 + 显式引用」而不是只写隐式样式：
        DatePicker 弹出来的那个 Calendar 是 DatePicker **在代码里 new 出来的**
        （模板里的 PART_Popup 是空的，控件自己 new Calendar 再挂上去），
        挂在 Popup 里的代码创建元素拿不到应用级隐式样式，结果就是「外面是深色、
        弹出来还是白的」。所以这里给每层都起个 key，由 DatePicker 的
        CalendarStyle 属性显式下发，一路覆盖到 CalendarItem 和日期格。

        颜色全部走 DynamicResource：主题切换只替换 MergedDictionaries[0]，
        这份字典不动，深浅两套自动跟着变，不用维护两份。
    -->

    <!-- 日历「上一页 / 下一页 / 年月标题」那三个按钮 -->
    <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 日期格（月视图里的 1..31） ================= -->
    <Style x:Key="ThemedCalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 今天：只描一圈主色，不抢选中态的位置 -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <!-- 选中：实心主色 + 白字，和主界面缩略图的选中框同一套语言 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </MultiTrigger>
                        <!-- 非本月日期：压暗但仍可点（点了会跳到那个月） -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarDayButton}"
           BasedOn="{StaticResource ThemedCalendarDayButtonStyle}" />

    <!-- ================= 年 / 十年视图里的月份、年份块 ================= -->
    <Style x:Key="ThemedCalendarMonthButtonStyle" TargetType="{x:Type CalendarButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 该月 / 该年里有选中过的日期 → 主色高亮 -->
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="HasSelectedDays" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarButton}"
           BasedOn="{StaticResource ThemedCalendarMonthButtonStyle}" />

    <!-- ================= CalendarItem：日历本体（标题栏 + 两个视图） ================= -->
    <Style x:Key="ThemedCalendarItemStyle" TargetType="{x:Type CalendarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <!-- 星期表头「一 二 三 …」 -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,2,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Root">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 标题栏：◀ 2026年10月 ▶ -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                            Style="{StaticResource CalendarNavButtonStyle}"
                                            ToolTip="上一页">
                                        <Path Data="M5,0 L1,5 L5,10"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="7" Height="10" Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                            Style="{StaticResource CalendarNavButtonStyle}"
                                            FontWeight="SemiBold"
                                            HorizontalContentAlignment="Center"
                                            ToolTip="点击切换：月 → 年 → 十年" />

                                    <Button x:Name="PART_NextButton" Grid.Column="2"
                                            Style="{StaticResource CalendarNavButtonStyle}"
                                            ToolTip="下一页">
                                        <Path Data="M1,0 L5,5 L1,10"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="7" Height="10" Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <!-- 月视图：7 列表头 + 6 行日期。子元素由 Calendar 自己填，
                                     这里只把网格骨架摆好（7 行 × 7 列，少一行就少一整周） -->
                                <Grid x:Name="PART_MonthView" Grid.Row="1"
                                      Visibility="Visible" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- 年 / 十年视图：3 行 × 4 列 -->
                                <Grid x:Name="PART_YearView" Grid.Row="1"
                                      Visibility="Hidden" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 禁用蒙层：Calendar 在 IsEnabled=False 时把它显出来 -->
                        <Rectangle x:Name="PART_DisabledVisual"
                                   Fill="{DynamicResource BgBrush}" Opacity="0.55"
                                   RadiusX="6" RadiusY="6"
                                   Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CalendarItem}"
           BasedOn="{StaticResource ThemedCalendarItemStyle}" />

    <!-- ================= Calendar 外壳 ================= -->
    <Style x:Key="ThemedCalendarStyle" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- 三个子样式都显式下发一遍，不指望隐式查找能穿过 Popup -->
        <Setter Property="CalendarItemStyle" Value="{StaticResource ThemedCalendarItemStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ThemedCalendarDayButtonStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource ThemedCalendarMonthButtonStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <StackPanel x:Name="CalendarRoot">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Style="{StaticResource ThemedCalendarItemStyle}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource ThemedCalendarStyle}" />

    <!-- ================= DatePicker ================= -->
    <!-- 内嵌文本框：默认模板自带一套浅色边框/水印，这里抹平，让外层 Border 说话 -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="4" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- 关键：弹出来的 Calendar 由 DatePicker 自己 new，只能靠这个属性把样式递进去 -->
        <Setter Property="CalendarStyle" Value="{StaticResource ThemedCalendarStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Padding="{TemplateBinding Padding}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   VerticalContentAlignment="Center" />

                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Style="{StaticResource CalendarNavButtonStyle}"
                                        Padding="7,4" Margin="0,0,2,0"
                                        ToolTip="选择日期">
                                    <!-- 日历小图标：一块框 + 顶部两个挂钩 -->
                                    <Grid Width="14" Height="14">
                                        <Border BorderBrush="{DynamicResource TextSecondaryBrush}"
                                                BorderThickness="1.2" CornerRadius="2" Margin="0,2,0,0" />
                                        <Rectangle Height="1.2" Margin="0,6,0,0"
                                                   VerticalAlignment="Top"
                                                   Fill="{DynamicResource TextSecondaryBrush}" />
                                        <Rectangle Width="1.6" Height="2.6" VerticalAlignment="Top"
                                                   HorizontalAlignment="Left" Margin="3,0,0,0"
                                                   Fill="{DynamicResource TextSecondaryBrush}" />
                                        <Rectangle Width="1.6" Height="2.6" VerticalAlignment="Top"
                                                   HorizontalAlignment="Right" Margin="0,0,3,0"
                                                   Fill="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               StaysOpen="False"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
