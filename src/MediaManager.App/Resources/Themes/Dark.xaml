<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题：**只放颜色赋值，一行模板都不许有**。
        所有控件模板都在 Styles.xaml（深浅共用），模板里一律 DynamicResource 引用这里的画刷。
        键名必须与 Light.xaml 一字不差 —— 少一个键的后果不是编译报错，
        而是那个控件在深色下变成透明或白块。
        守门：build/verify/verify_design_tokens.py
    -->

    <!-- 颜色 -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryLightColor">#1E3A5F</Color>
    <!-- 压在实心主色上的文字与图形。两套主题都是白字，但不能共用写死的 White ——
         哪天主色提亮到白字看不清，改这一行就够 -->
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <!-- 危险/不可逆语义。深色底上 #B42318 会糊成暗块，提亮到 #EF4444 才看得清 -->
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="OnDangerColor">#FFFFFF</Color>
    <Color x:Key="BgColor">#1E1E1E</Color>
    <Color x:Key="PanelColor">#252526</Color>
    <Color x:Key="SidebarColor">#2D2D30</Color>
    <Color x:Key="TextColor">#F0F0F0</Color>
    <Color x:Key="TextSecondaryColor">#AEB6C0</Color>
    <Color x:Key="BorderColor">#3F3F46</Color>
    <Color x:Key="HoverColor">#3E3E42</Color>
    <Color x:Key="SelectedColor">#1E3A5F</Color>
    <!-- 骨架屏底色：比面板再暗一档的深灰，不能纯黑（纯黑会被当成"没内容"） -->
    <Color x:Key="SkeletonColor">#1C1C1E</Color>
    <!-- 禁用文字：比次要文字再暗一档，深色底上要明显"退下去"又不至于看不见 -->
    <Color x:Key="DisabledColor">#6B7280</Color>
    <!-- 收藏星：两套主题都取琥珀金，不跟主色走。深色底上比浅色那档再亮一点 -->
    <Color x:Key="FavoriteColor">#FBBF24</Color>

    <!-- 画刷（模板只认画刷，不认 Color） -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}" />
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="{StaticResource FavoriteColor}" />

    <!-- 缩略图选中描边，跟主色同一支蓝。删除模式的琥珀色由代码临时覆盖，不在这里 -->
    <SolidColorBrush x:Key="ThumbSelectionBrush" Color="{StaticResource PrimaryColor}" />

    <!-- 滚动条滑块三态。原来后两态写死在模板里，模板抽走后必须单独成键 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A4F" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5E5E64" />
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#6E6E74" />

</ResourceDictionary>
