# ============================================================
# MediaManager — .gitignore
# 说明：本文件同时排除「编译产物 / 本地数据 / 隐私文件 / 大二进制」，
#       确保开源仓库干净、不泄露任何本地隐私数据。
# ============================================================

# ---------- 编译产物 ----------
bin/
obj/
dist/
publish/
*.user
*.suo
.vs/

# ---------- 数据库与本地数据 ----------
*.db
*.db-shm
*.db-wal
*.mmdb
library.db*
*.bak*
*.log
logs/
portable.marker

# ---------- 隐私 / 工具运行数据（严禁上传） ----------
# 含真实媒体库元数据、机器路径、工作记忆、自动化日志、截图
.workbuddy/
db_backup/
@AutomationLog.txt
screenshot.png

# ---------- 大二进制（单独下载，不进仓库） ----------
# ffmpeg 约 100MB，发布安装包时需自行放入 tools/ffmpeg/（见 README）
tools/ffmpeg/

# ---------- 本地 / 内部文档（非开源内容，不入库） ----------
*.pdf
*.docx
工作报告*.md
性能优化报告*.md
开发日志与规划.md
产品功能介绍.md

# ---------- 系统 / 编辑器临时文件 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本地 UI 自动化 / 截图测试脚本（含本机绝对路径） ----------
build/uia_*.py
build/capture_main_window.py
build/*_log.txt
build/skel_*.jpg
build/screen_now.jpg
