# ============================================================
# MediaManager — .gitignore
# 说明：本文件同时排除「编译产物 / 本地数据 / 隐私文件 / 大二进制」，
#       确保开源仓库干净、不泄露任何本地隐私数据。
# ============================================================

# ---------- 编译产物 ----------
bin/
obj/
dist/
publish/
*.user
*.suo
.vs/

# ---------- 数据库与本地数据 ----------
*.db
*.db-shm
*.db-wal
*.mmdb
library.db*
*.bak*
*.log
logs/
portable.marker

# ---------- 隐私 / 工具运行数据（严禁上传） ----------
# 含真实媒体库元数据、机器路径、工作记忆、自动化日志、截图
.workbuddy/
db_backup/
@AutomationLog.txt
screenshot.png

# ---------- 大二进制（单独下载，不进仓库） ----------
# ffmpeg 约 100MB，发布安装包时需自行放入 tools/ffmpeg/（见 README）
tools/ffmpeg/

# ---------- 本地 / 内部文档（非开源内容，不入库） ----------
*.pdf
*.docx
工作报告*.md
性能优化报告*.md
开发日志与规划.md
产品功能介绍.md

# ---------- 系统 / 编辑器临时文件 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本地 UI 自动化 / 截图测试脚本（含本机绝对路径） ----------
build/uia_*.py
build/verify*.py
build/probe_*.py
build/capture_main_window.py
build/publish_release.py
build/*_log.txt
build/verify_shots/
build/verify_shots_diary/
build/testmedia/
build/skel_*.jpg
build/screen_now.jpg

# ---------- v1.3.0 起补充 ----------
# 本地打包中转目录（几百 MB 的 libvlc/ffmpeg 副本）
artifacts/
# 比赛宣传图与版式（本机产物，仓库不需要）
docs/promo/
build/promo/
# 验收截图 / 验证日志 / 一次性诊断脚本
build/v130/
build/acceptance/
build/verify*.txt
build/diag_*.py
# 发版用的更新说明（正文走 Release，不入库）
更新说明*.md
build/acceptance.py
# 社交预览校验的临时抓图（check_social_preview.py 产物）
build/og_preview_check.png
# 封面重刷脚本的预览产物（patch_cover_version.py --dry-run）
build/_cover_preview.png
build/_cover_cmp.png
# 重新截图前临时备份的库（uia_shot_theme.py 前置清理用）
build/_db_backup*.db
TestResults/
代码评审*.md
